---
import type { MediaValue } from "emdash";
import MediaImg from "./MediaImg.astro";
import { tagHref, formatDateJa, isoDate, categoryEn } from "../utils/categories";

interface Props {
	title: string;
	excerpt?: string;
	featuredImage?: MediaValue | string;
	href: string;
	date?: Date;
	readingTime?: number;
	category?: { slug: string; label: string };
	tags?: Array<{ slug: string; label: string }>;
	/** Render the title as h3 (when the card sits under an h2 section title) */
	headingLevel?: "h2" | "h3";
	/** "card": image on top (grids). "row": thumbnail left, ruled list (archives). */
	variant?: "card" | "row";
	/** Running number shown in the kicker (row variant) */
	index?: number;
	eager?: boolean;
}

const {
	title,
	excerpt,
	featuredImage,
	href,
	date,
	readingTime,
	category,
	tags,
	headingLevel = "h3",
	variant = "card",
	index,
} = Astro.props;

const Heading = headingLevel;
const formattedDate = formatDateJa(date);
const catEn = category ? categoryEn(category.slug) : "";
const shownTags = (tags ?? []).slice(0, 3);
---

{
	variant === "row" ? (
		<article class="row-item">
			<a href={href} class="row-thumb" aria-hidden="true" tabindex="-1">
				{featuredImage ? <MediaImg image={featuredImage} variant="thumb" alt="" /> : <span class="thumb-blank" />}
			</a>
			<div class="row-body">
				<p class="meta row-kicker">
					{typeof index === "number" && <span class="row-no">{String(index).padStart(2, "0")}</span>}
					{category && <a href={`/${category.slug}/`} class="cat-word">{catEn}<span class="cat-ja">{category.label}</span></a>}
					{formattedDate && <time datetime={isoDate(date)}>{formattedDate}</time>}
					{readingTime && <span>{readingTime} min</span>}
				</p>
				<Heading class="row-title">
					<a href={href}>{title}</a>
				</Heading>
				{excerpt && <p class="row-excerpt">{excerpt}</p>}
				{shownTags.length > 0 && (
					<p class="row-meta row-tags">
						{shownTags.map((t) => (
							<a href={tagHref(t.slug)} class="tag-pill">
								{t.label}
							</a>
						))}
					</p>
				)}
			</div>
		</article>
	) : (
		<article class="post-card">
			<a href={href} class="card-image" aria-hidden="true" tabindex="-1">
				{featuredImage ? <MediaImg image={featuredImage} variant="thumb" alt="" /> : <span class="thumb-blank" />}
			</a>
			<p class="meta card-kicker">
				{category && <a href={`/${category.slug}/`} class="cat-word">{catEn}<span class="cat-ja">{category.label}</span></a>}
				{formattedDate && <time datetime={isoDate(date)}>{formattedDate}</time>}
				{readingTime && <span>{readingTime} min</span>}
			</p>
			<Heading class="card-title">
				<a href={href}>{title}</a>
			</Heading>
			{excerpt && <p class="card-excerpt">{excerpt}</p>}
			{shownTags.length > 0 && (
				<p class="card-tags">
					{shownTags.map((t) => (
						<a href={tagHref(t.slug)} class="tag-pill">
							{t.label}
						</a>
					))}
				</p>
			)}
		</article>
	)
}

<style>
	/* ---- Shared ---- */
	.thumb-blank {
		display: block;
		width: 100%;
		height: 100%;
		background:
			repeating-linear-gradient(
				-45deg,
				transparent 0 6px,
				var(--color-border-subtle) 6px 7px
			),
			var(--color-bg-subtle);
	}

	.card-kicker,
	.row-kicker {
		display: flex;
		flex-wrap: wrap;
		gap: 0 var(--spacing-3);
		margin-bottom: var(--spacing-2);
	}

	.card-kicker time,
	.row-kicker time {
		color: var(--color-muted);
	}

	.cat-word {
		font-family: var(--font-display);
		font-weight: 700;
		font-size: 1rem;
		line-height: 1;
		text-transform: uppercase;
		letter-spacing: 0.03em;
		color: var(--color-brand);
		text-decoration: none;
		align-self: baseline;
	}

	.cat-ja {
		font-family: var(--font-body);
		font-size: 0.68rem;
		font-weight: 500;
		letter-spacing: 0;
		color: var(--color-muted);
		margin-left: 0.4em;
	}

	.cat-word:hover {
		color: var(--color-text);
	}

	/* ---- Card variant ---- */
	.post-card {
		display: flex;
		flex-direction: column;
		min-width: 0;
	}

	.card-image {
		display: block;
		aspect-ratio: 16 / 10;
		overflow: hidden;
		border-radius: 0;
		border: 1px solid var(--color-rule-strong);
		background: var(--color-surface);
		margin-bottom: var(--spacing-4);
		transition: box-shadow var(--transition-fast), transform var(--transition-fast);
	}

	.post-card:hover .card-image {
		box-shadow: 6px 6px 0 0 var(--color-brand);
		transform: translate(-2px, -2px);
	}

	.card-image :global(img) {
		width: 100%;
		height: 100%;
		object-fit: cover;
	}

	.card-title {
		font-size: var(--font-size-lg);
		font-weight: 700;
		line-height: 1.45;
		margin-bottom: var(--spacing-2);
	}

	.card-title a,
	.row-title a {
		color: var(--color-text);
		text-decoration: none;
	}

	.card-title a:hover,
	.row-title a:hover {
		text-decoration: underline;
		text-decoration-color: var(--color-brand);
		text-decoration-thickness: 2px;
		text-underline-offset: 4px;
	}

	.card-excerpt {
		font-size: var(--font-size-sm);
		line-height: 1.75;
		color: var(--color-text-secondary);
		display: -webkit-box;
		-webkit-line-clamp: 3;
		-webkit-box-orient: vertical;
		overflow: hidden;
	}

	.card-tags,
	.row-tags {
		display: flex;
		flex-wrap: wrap;
		gap: 0 var(--spacing-3);
		margin-top: var(--spacing-3);
	}

	/* ---- Row variant: layout lives in theme.css (.row-item) ---- */
	.row-thumb {
		display: block;
	}

	.row-body {
		min-width: 0;
	}
</style>
