---
import type { MediaValue } from "emdash";
import { Image } from "emdash/ui";
import { formatDateJa, isoDate } from "../utils/categories";

interface Props {
	title: string;
	excerpt?: string;
	featuredImage?: MediaValue | string;
	href: string;
	date?: Date;
	readingTime?: number;
	category?: { slug: string; label: string };
	tags?: Array<{ slug: string; label: string }>;
	/** Render the title as h3 (when the card sits under an h2 section title) */
	headingLevel?: "h2" | "h3";
	eager?: boolean;
}

const {
	title,
	excerpt,
	featuredImage,
	href,
	date,
	readingTime,
	category,
	tags,
	headingLevel = "h3",
} = Astro.props;

const Heading = headingLevel;
const formattedDate = formatDateJa(date);
---

<article class="post-card">
	<a href={href} class="card-link">
		{
			featuredImage ? (
				<div class="card-image">
					<Image image={featuredImage} />
				</div>
			) : (
				<div class="card-placeholder" aria-hidden="true">
					<span>永住地</span>
				</div>
			)
		}
		<div class="card-body">
			<div class="card-meta">
				{
					category && (
						<span class:list={["cat-chip", `cat-chip--${category.slug}`]}>
							{category.label}
						</span>
					)
				}
				{formattedDate && <time datetime={isoDate(date)}>{formattedDate}</time>}
				{readingTime && <span class="card-read">約{readingTime}分</span>}
			</div>
			<Heading class="card-title">{title}</Heading>
			{excerpt && <p class="card-excerpt">{excerpt}</p>}
		</div>
	</a>
	{
		tags && tags.length > 0 && (
			<div class="card-tags">
				{tags.slice(0, 3).map((tag) => (
					<a href={`/tag/${tag.slug}`} class="tag-pill">
						{tag.label}
					</a>
				))}
			</div>
		)
	}
</article>

<style>
	.post-card {
		display: flex;
		flex-direction: column;
		height: 100%;
	}

	.card-link {
		display: block;
		text-decoration: none;
		color: inherit;
		flex: 1;
	}

	.card-image,
	.card-placeholder {
		position: relative;
		aspect-ratio: 16 / 9;
		overflow: hidden;
		border-radius: var(--radius-lg);
		background: var(--color-surface);
		margin-bottom: var(--spacing-4);
		border: 1px solid var(--color-border-subtle);
		transition:
			box-shadow var(--transition-base),
			transform var(--transition-base);
	}

	.card-image img {
		width: 100%;
		height: 100%;
		object-fit: cover;
		transition: transform 0.45s cubic-bezier(0.2, 0.7, 0.2, 1);
	}

	.card-link:hover .card-image,
	.card-link:hover .card-placeholder {
		box-shadow: var(--shadow-card);
		transform: translateY(-2px);
	}

	.card-link:hover .card-image img {
		transform: scale(1.04);
	}

	/* Glitch edge on hover */
	.card-image::after {
		content: "";
		position: absolute;
		inset: auto 0 0 0;
		height: 3px;
		background: var(--gradient-glitch);
		transform: scaleX(0);
		transform-origin: left;
		transition: transform 0.35s cubic-bezier(0.2, 0.7, 0.2, 1);
	}

	.card-link:hover .card-image::after {
		transform: scaleX(1);
	}

	.card-placeholder {
		display: grid;
		place-items: center;
		color: var(--color-muted);
		font-weight: 800;
		font-size: var(--font-size-2xl);
		letter-spacing: 0.2em;
		background:
			radial-gradient(circle at 20% 20%, color-mix(in srgb, var(--color-brand) 14%, transparent), transparent 55%),
			radial-gradient(circle at 80% 80%, color-mix(in srgb, var(--color-accent) 16%, transparent), transparent 55%),
			var(--color-surface);
	}

	.card-meta {
		display: flex;
		align-items: center;
		flex-wrap: wrap;
		gap: var(--spacing-2) var(--spacing-3);
		font-size: var(--font-size-xs);
		color: var(--color-muted);
		margin-bottom: var(--spacing-2);
	}

	.card-meta time,
	.card-read {
		white-space: nowrap;
	}

	.card-title {
		font-size: var(--font-size-lg);
		font-weight: var(--font-weight-heading);
		line-height: var(--leading-snug);
		margin-bottom: var(--spacing-2);
		transition: color var(--transition-fast);
		display: -webkit-box;
		-webkit-line-clamp: 3;
		-webkit-box-orient: vertical;
		overflow: hidden;
	}

	.card-link:hover .card-title {
		color: var(--color-brand);
	}

	.card-excerpt {
		font-size: var(--font-size-sm);
		line-height: var(--leading-relaxed);
		color: var(--color-text-secondary);
		display: -webkit-box;
		-webkit-line-clamp: 2;
		-webkit-box-orient: vertical;
		overflow: hidden;
	}

	.card-tags {
		display: flex;
		flex-wrap: wrap;
		gap: var(--spacing-2);
		margin-top: var(--spacing-3);
	}
</style>
