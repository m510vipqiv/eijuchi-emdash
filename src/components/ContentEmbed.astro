---
/**
 * Portable Text `embed` block override for article bodies.
 *
 * WordPress rendered oEmbeds on the fly, so imported blocks only carry the
 * source URL (their `html` is just the wp-block-embed wrapper). This rebuilds:
 *   twitter / x.com  → blockquote.twitter-tweet + widgets.js (see scripts/twitter-widgets.ts)
 *   youtube / vimeo  → lazy, privacy-enhanced iframe (16:9)
 *   amazon           → affiliate link card
 *   eijuchi.com post → internal post card (title / category / thumbnail)
 *   reddit / other   → link card
 *   provider video / audio → native <video> / <audio>
 */
import { getEmDashEntry, getEntryTerms } from "emdash";
import MediaImg from "./MediaImg.astro";
import { categoryEn, categoryLabel, postHref, primaryCategory } from "../utils/categories";
import {
	amazonAsin,
	amazonTitle,
	classify,
	internalSlug,
	safeUrl,
	tweetUrl,
	vimeoId,
	youtubeId,
	youtubeStart,
} from "../utils/embeds";

interface Props {
	node: {
		_type: "embed";
		_key: string;
		url: string;
		provider?: string;
		html?: string;
		caption?: string;
	};
}

const { node } = Astro.props;
const rawUrl = node?.url ?? "";
const url = safeUrl(rawUrl);
const kind = url ? classify(rawUrl, node.provider) : "link";
const caption = node?.caption;

// ---- per-kind data ----
const tweet = kind === "twitter" ? tweetUrl(rawUrl) : null;

const ytId = kind === "youtube" ? youtubeId(rawUrl) : null;
const ytStart = kind === "youtube" ? youtubeStart(rawUrl) : undefined;
const ytSrc = ytId ? `https://www.youtube-nocookie.com/embed/${ytId}${ytStart ? `?start=${ytStart}` : ""}` : null;

const vmId = kind === "vimeo" ? vimeoId(rawUrl) : null;

const asin = kind === "amazon" && url ? amazonAsin(rawUrl) : null;
const amazonName = kind === "amazon" && url ? amazonTitle(url) : null;

let internal:
	| { href: string; title: string; excerpt?: string; cat: string; image?: unknown }
	| null = null;
if (kind === "internal" && url) {
	const slug = internalSlug(url);
	if (slug) {
		try {
			const { entry } = await getEmDashEntry("posts", slug);
			if (entry) {
				const cats = await getEntryTerms("posts", entry.data.id, "category");
				const cat = primaryCategory(cats);
				internal = {
					href: postHref(cat, entry.id),
					title: entry.data.title,
					excerpt: entry.data.excerpt ?? undefined,
					cat,
					image: entry.data.featured_image,
				};
			}
		} catch {
			internal = null;
		}
	}
}

const hostLabel = url ? url.hostname.replace(/^www\./, "") : "";
const displayPath = url ? decodeURIComponent(url.pathname).replace(/\/$/, "") : "";
---

{
	!url ? null : kind === "twitter" && tweet ? (
		<figure class="body-embed body-embed--tweet">
			<blockquote class="twitter-tweet" data-dnt="true">
				<a href={tweet} rel="noopener noreferrer" target="_blank">
					Xの投稿を見る →
				</a>
			</blockquote>
			{caption && <figcaption>{caption}</figcaption>}
		</figure>
	) : kind === "youtube" && ytSrc ? (
		<figure class="body-embed body-embed--video">
			<div class="video-frame">
				<iframe
					src={ytSrc}
					title="YouTube video"
					loading="lazy"
					allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
					referrerpolicy="strict-origin-when-cross-origin"
					allowfullscreen
				/>
			</div>
			{caption && <figcaption>{caption}</figcaption>}
		</figure>
	) : kind === "vimeo" && vmId ? (
		<figure class="body-embed body-embed--video">
			<div class="video-frame">
				<iframe
					src={`https://player.vimeo.com/video/${vmId}?dnt=1`}
					title="Vimeo video"
					loading="lazy"
					allow="autoplay; fullscreen; picture-in-picture"
					allowfullscreen
				/>
			</div>
			{caption && <figcaption>{caption}</figcaption>}
		</figure>
	) : kind === "video" ? (
		<figure class="body-embed body-embed--video">
			<div class="video-frame">
				<video controls preload="metadata" src={url.href} />
			</div>
			{caption && <figcaption>{caption}</figcaption>}
		</figure>
	) : kind === "audio" ? (
		<figure class="body-embed body-embed--audio">
			<audio controls preload="metadata" src={url.href} />
			{caption && <figcaption>{caption}</figcaption>}
		</figure>
	) : kind === "internal" && internal ? (
		<figure class="body-embed body-embed--internal">
			<a href={internal.href} class="embed-card embed-card--post">
				{internal.image ? (
					<span class="embed-card-thumb">
						<MediaImg image={internal.image as never} variant="thumb" alt="" />
					</span>
				) : null}
				<span class="embed-card-body">
					<span class="embed-card-kicker">
						<span class="embed-card-en">{categoryEn(internal.cat)}</span>
						<span class="embed-card-ja">{categoryLabel(internal.cat)}</span>
						<span class="embed-card-site">eijuchi.com</span>
					</span>
					<span class="embed-card-title">{internal.title}</span>
					{internal.excerpt && <span class="embed-card-excerpt">{internal.excerpt}</span>}
				</span>
			</a>
			{caption && <figcaption>{caption}</figcaption>}
		</figure>
	) : kind === "amazon" ? (
		<figure class="body-embed body-embed--amazon">
			<a href={url.href} class="embed-card embed-card--amazon" target="_blank" rel="nofollow sponsored noopener noreferrer">
				<span class="embed-card-body">
					<span class="embed-card-kicker">
						<span class="embed-card-en">Amazon</span>
						<span class="embed-card-ja">amazon.co.jp</span>
					</span>
					<span class="embed-card-title">{amazonName ?? "Amazonで商品を見る"}</span>
					<span class="embed-card-cta">
						{amazonName ? "Amazonで見る →" : "商品ページへ →"}
						{asin && <span class="embed-card-asin">ASIN {asin}</span>}
					</span>
				</span>
			</a>
			{caption && <figcaption>{caption}</figcaption>}
		</figure>
	) : (
		<figure class="body-embed body-embed--link">
			<a href={url.href} class="embed-card embed-card--link" target="_blank" rel="noopener noreferrer">
				<span class="embed-card-body">
					<span class="embed-card-kicker">
						<span class="embed-card-en">{kind === "reddit" ? "Reddit" : "Link"}</span>
						<span class="embed-card-ja">{hostLabel}</span>
					</span>
					<span class="embed-card-title">{displayPath || url.href}</span>
					<span class="embed-card-cta">{hostLabel} で開く →</span>
				</span>
			</a>
			{caption && <figcaption>{caption}</figcaption>}
		</figure>
	)
}

<script src="../scripts/twitter-widgets.ts"></script>

<style>
	.body-embed {
		margin: 2em 0;
	}

	.body-embed figcaption {
		font-family: var(--font-mono);
		font-size: 0.72rem;
		color: var(--color-muted);
		text-align: center;
		margin-top: 0.6em;
	}

	/* ---- video ---- */
	.video-frame {
		position: relative;
		aspect-ratio: 16 / 9;
		background: var(--color-bg-subtle);
		border: 1px solid var(--color-rule-strong);
	}

	.video-frame iframe,
	.video-frame video {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
		border: 0;
		background: #000;
	}

	.body-embed--audio audio {
		width: 100%;
	}

	/* ---- tweet (placeholder before widgets.js swaps it in) ---- */
	.body-embed--tweet {
		display: flex;
		justify-content: center;
	}

	.body-embed--tweet :global(.twitter-tweet) {
		margin: 0 auto;
		max-width: 550px;
		width: 100%;
	}

	.body-embed--tweet blockquote.twitter-tweet:not(.twitter-tweet-rendered) {
		border: 1px solid var(--color-rule-strong);
		padding: var(--spacing-4) var(--spacing-5);
		font-size: var(--font-size-sm);
		font-style: normal;
		background: var(--color-surface);
	}

	.body-embed--tweet blockquote.twitter-tweet:not(.twitter-tweet-rendered) a {
		color: var(--color-text);
		text-decoration: none;
		font-weight: 700;
	}

	/* ---- cards (internal / amazon / link) ---- */
	.embed-card {
		display: grid;
		grid-template-columns: minmax(0, 1fr);
		gap: 0 var(--spacing-5);
		border: 1px solid var(--color-rule-strong);
		background: var(--color-surface);
		color: var(--color-text);
		text-decoration: none;
		padding: var(--spacing-4) var(--spacing-5);
		transition: box-shadow var(--transition-fast), transform var(--transition-fast);
	}

	.embed-card:hover {
		box-shadow: 6px 6px 0 0 var(--color-brand);
		transform: translate(-2px, -2px);
	}

	.embed-card--post:has(.embed-card-thumb) {
		grid-template-columns: 160px minmax(0, 1fr);
		padding: 0;
	}

	.embed-card-thumb {
		display: block;
		aspect-ratio: 4 / 3;
		overflow: hidden;
		border-right: 1px solid var(--color-rule-strong);
	}

	.embed-card-thumb :global(img) {
		width: 100%;
		height: 100%;
		object-fit: cover;
	}

	.embed-card--post:has(.embed-card-thumb) .embed-card-body {
		padding: var(--spacing-4) var(--spacing-5);
	}

	.embed-card-body {
		display: flex;
		flex-direction: column;
		gap: var(--spacing-1);
		min-width: 0;
	}

	.embed-card-kicker {
		display: flex;
		align-items: baseline;
		gap: var(--spacing-2);
		font-family: var(--font-mono);
		font-size: 0.68rem;
		color: var(--color-muted);
		letter-spacing: 0.04em;
	}

	.embed-card-en {
		font-family: var(--font-display);
		font-weight: 700;
		font-size: 1rem;
		letter-spacing: 0.03em;
		text-transform: uppercase;
		color: var(--color-brand);
	}

	.embed-card-site {
		margin-left: auto;
	}

	.embed-card-title {
		font-weight: 700;
		font-size: var(--font-size-base);
		line-height: 1.5;
		word-break: break-word;
	}

	.embed-card-excerpt {
		font-size: var(--font-size-sm);
		line-height: 1.7;
		color: var(--color-text-secondary);
		display: -webkit-box;
		-webkit-line-clamp: 2;
		-webkit-box-orient: vertical;
		overflow: hidden;
	}

	.embed-card-cta {
		display: flex;
		gap: var(--spacing-3);
		align-items: baseline;
		margin-top: var(--spacing-1);
		font-size: var(--font-size-sm);
		font-weight: 700;
		color: var(--color-brand);
	}

	.embed-card-asin {
		font-family: var(--font-mono);
		font-size: 0.68rem;
		font-weight: 400;
		color: var(--color-muted);
	}

	@media (max-width: 600px) {
		.embed-card--post:has(.embed-card-thumb) {
			grid-template-columns: 1fr;
		}

		.embed-card-thumb {
			aspect-ratio: 16 / 9;
			border-right: 0;
			border-bottom: 1px solid var(--color-rule-strong);
		}
	}
</style>
