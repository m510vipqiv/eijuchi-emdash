---
/** WordPress /category/{slug} → /{slug} (top-level category archives) */
import { decodeSlug } from "emdash";
import { isCategorySlug } from "../../utils/categories";

const slug = decodeSlug(Astro.params.slug);
if (!slug || !isCategorySlug(slug)) return Astro.redirect("/articles", 301);
return Astro.redirect(`/${slug}`, 301);
---
