---
/**
 * /tags — tag index. Consolidated/deleted WordPress tags 301 here.
 */
import { getTaxonomyTerms, getSiteSettings } from "emdash";
import Base from "../layouts/Base.astro";
import { resolveBlogSiteIdentity, siteOrigin } from "../utils/site-identity";
import { tagHref } from "../utils/categories";

const origin = siteOrigin(Astro.url);
const { siteTitle } = resolveBlogSiteIdentity(await getSiteSettings());

const terms = (await getTaxonomyTerms("tag"))
	.filter((t) => (t.count ?? 0) > 0)
	.sort((a, b) => (b.count ?? 0) - (a.count ?? 0) || a.label.localeCompare(b.label, "ja"));

const max = terms[0]?.count ?? 1;
function weight(count: number | undefined) {
	const c = count ?? 0;
	if (c >= max * 0.6) return "xl";
	if (c >= max * 0.3) return "lg";
	if (c >= 3) return "md";
	return "sm";
}
---

<Base title="タグ一覧" description={`${siteTitle}で扱っているゲームタイトル・トピックのタグ一覧。`} canonical={`${origin}/tags/`}>
	<section class="tags-page">
		<header class="page-header">
			<p class="outline-word page-word" aria-hidden="true">Tags</p>
			<p class="kicker"><span class="tag-block">Tags</span></p>
			<h1 class="page-title">タグ一覧</h1>
			<p class="meta page-description">{terms.length} tags</p>
		</header>

		{
			terms.length === 0 ? (
				<p class="empty">タグがまだありません。</p>
			) : (
				<ul class="tag-cloud">
					{terms.map((t) => (
						<li>
							<a href={tagHref(t.slug)} class:list={["tag-item", `tag-item--${weight(t.count)}`]}>
								<span class="tag-label">{t.label}</span>
								<span class="tag-count">{t.count}</span>
							</a>
						</li>
					))}
				</ul>
			)
		}
	</section>
</Base>

<style>
	.tags-page {
		max-width: 860px;
		margin: 0 auto;
		padding: var(--spacing-10) var(--spacing-6) var(--spacing-16);
	}

	.page-header {
		position: relative;
		margin-bottom: var(--spacing-10);
		padding-bottom: var(--spacing-6);
		border-bottom: 2px solid var(--color-rule-strong);
		overflow: hidden;
	}

	.page-word {
		position: absolute;
		right: -0.03em;
		bottom: 0.05em;
		font-size: clamp(5rem, 16vw, 11rem);
	}

	.page-header > :not(.page-word) {
		position: relative;
	}

	.page-header .kicker {
		margin-bottom: var(--spacing-3);
	}

	.page-title {
		font-size: clamp(2.4rem, 5vw, 3.4rem);
		font-weight: 900;
		line-height: 1.15;
		letter-spacing: -0.01em;
		margin-bottom: var(--spacing-3);
	}

	.empty {
		color: var(--color-muted);
	}

	/* Two/three-column ruled index, like a magazine's back-page index */
	.tag-cloud {
		list-style: none;
		columns: 3;
		column-gap: var(--spacing-10);
	}

	.tag-cloud li {
		break-inside: avoid;
	}

	.tag-item {
		display: flex;
		align-items: baseline;
		gap: var(--spacing-3);
		padding: var(--spacing-2) 0;
		border-bottom: 1px solid var(--color-border-subtle);
		color: var(--color-text);
		text-decoration: none;
		font-size: var(--font-size-sm);
	}

	.tag-label {
		flex: 1;
		min-width: 0;
	}

	.tag-item:hover .tag-label {
		text-decoration: underline;
		text-decoration-color: var(--color-brand);
		text-underline-offset: 3px;
	}

	.tag-item--xl .tag-label,
	.tag-item--lg .tag-label {
		font-weight: 700;
	}

	.tag-item--xl .tag-label {
		font-size: var(--font-size-base);
	}

	.tag-count {
		font-family: var(--font-mono);
		font-size: 0.72rem;
		color: var(--color-muted);
		font-feature-settings: "tnum" 1;
	}

	@media (max-width: 800px) {
		.tag-cloud {
			columns: 2;
		}
	}

	@media (max-width: 600px) {
		.tags-page {
			padding: var(--spacing-6) var(--spacing-4) var(--spacing-12);
		}

		.page-title {
			font-size: var(--font-size-3xl);
		}

		.tag-cloud {
			columns: 1;
		}
	}
</style>
