---
/**
 * /tags — tag index. Consolidated/deleted WordPress tags 301 here.
 */
import { getTaxonomyTerms, getSiteSettings } from "emdash";
import Base from "../layouts/Base.astro";
import { resolveBlogSiteIdentity, siteOrigin } from "../utils/site-identity";

const origin = siteOrigin(Astro.url);
const { siteTitle } = resolveBlogSiteIdentity(await getSiteSettings());

const terms = (await getTaxonomyTerms("tag"))
	.filter((t) => (t.count ?? 0) > 0)
	.sort((a, b) => (b.count ?? 0) - (a.count ?? 0) || a.label.localeCompare(b.label, "ja"));

const max = terms[0]?.count ?? 1;
function weight(count: number | undefined) {
	const c = count ?? 0;
	if (c >= max * 0.6) return "xl";
	if (c >= max * 0.3) return "lg";
	if (c >= 3) return "md";
	return "sm";
}
---

<Base title="タグ一覧" description={`${siteTitle}で扱っているゲームタイトル・トピックのタグ一覧。`} canonical={`${origin}/tags`}>
	<section class="tags-page">
		<header class="page-header">
			<h1 class="page-title"><span class="glitch-bar" aria-hidden="true"></span>タグ一覧</h1>
			<p class="page-description">{terms.length}件のタグ</p>
		</header>

		{
			terms.length === 0 ? (
				<p class="empty">タグがまだありません。</p>
			) : (
				<ul class="tag-cloud">
					{terms.map((t) => (
						<li>
							<a href={`/tag/${t.slug}`} class:list={["tag-item", `tag-item--${weight(t.count)}`]}>
								<span class="tag-hash" aria-hidden="true">#</span>
								{t.label}
								<span class="tag-count">{t.count}</span>
							</a>
						</li>
					))}
				</ul>
			)
		}
	</section>
</Base>

<style>
	.tags-page {
		max-width: 900px;
		margin: 0 auto;
		padding: var(--spacing-10) var(--spacing-6) var(--spacing-20);
	}

	.page-header {
		margin-bottom: var(--spacing-10);
	}

	.page-title {
		display: flex;
		align-items: center;
		gap: var(--spacing-3);
		font-size: var(--font-size-3xl);
		font-weight: var(--font-weight-display);
		margin-bottom: var(--spacing-2);
	}

	.page-description,
	.empty {
		color: var(--color-muted);
	}

	.tag-cloud {
		list-style: none;
		display: flex;
		flex-wrap: wrap;
		gap: var(--spacing-3);
	}

	.tag-item {
		display: inline-flex;
		align-items: center;
		gap: 0.3em;
		padding: 0.4em 0.9em;
		border-radius: 999px;
		border: 1px solid var(--color-border);
		background: var(--color-bg);
		color: var(--color-text);
		text-decoration: none;
		font-size: var(--font-size-sm);
		transition:
			border-color var(--transition-fast),
			color var(--transition-fast),
			transform var(--transition-fast),
			box-shadow var(--transition-fast);
	}

	.tag-item:hover {
		border-color: var(--color-brand);
		color: var(--color-brand);
		transform: translateY(-1px);
		box-shadow: var(--shadow-sm);
	}

	.tag-item--xl {
		font-size: var(--font-size-xl);
		font-weight: 700;
	}

	.tag-item--lg {
		font-size: var(--font-size-lg);
		font-weight: 600;
	}

	.tag-item--md {
		font-size: var(--font-size-base);
	}

	.tag-hash {
		color: var(--color-accent);
		font-weight: 700;
	}

	.tag-count {
		font-size: 0.75em;
		color: var(--color-muted);
		background: var(--color-surface);
		padding: 0 0.5em;
		border-radius: 999px;
	}

	@media (max-width: 600px) {
		.tags-page {
			padding: var(--spacing-6) var(--spacing-4) var(--spacing-12);
		}
	}
</style>
