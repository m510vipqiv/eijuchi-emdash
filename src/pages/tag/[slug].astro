---
import { getTerm, getEmDashCollection, getTermsForEntries, decodeSlug, getSiteSettings } from "emdash";
import Base from "../../layouts/Base.astro";
import PostCard from "../../components/PostCard.astro";
import { getReadingTime } from "../../utils/reading-time";
import { resolveBlogSiteIdentity, siteOrigin } from "../../utils/site-identity";
import { tagHref, tagSlugCandidates, primaryCategory, categoryLabel, postHref } from "../../utils/categories";

const slug = decodeSlug(Astro.params.slug);
let term: Awaited<ReturnType<typeof getTerm>> = null;
if (slug) {
	for (const candidate of tagSlugCandidates(slug)) {
		term = await getTerm("tag", candidate);
		if (term) break;
	}
}
if (!term) return new Response(null, { status: 404 });

const PER_PAGE = 24;
const cursor = Astro.url.searchParams.get("cursor") ?? undefined;
const origin = siteOrigin(Astro.url);
const { siteTitle } = resolveBlogSiteIdentity(await getSiteSettings());

const { entries: posts, cacheHint, nextCursor } = await getEmDashCollection("posts", {
	status: "published",
	where: { tag: term.slug },
	orderBy: { published_at: "desc" },
	limit: PER_PAGE,
	cursor,
});
if (Astro.cache?.enabled) Astro.cache.set(cacheHint);

const ids = posts.map((p) => p.data.id);
const [catsByEntry, tagsByEntry] = await Promise.all([
	getTermsForEntries("posts", ids, "category"),
	getTermsForEntries("posts", ids, "tag"),
]);

const items = posts.map((post) => {
	const cat = primaryCategory(catsByEntry.get(post.data.id));
	return {
		post,
		category: { slug: cat, label: categoryLabel(cat) },
		tags: (tagsByEntry.get(post.data.id) ?? []).map((t) => ({ slug: t.slug, label: t.label })),
	};
});

const count = term.count ?? posts.length;
const canonical = `${origin}${tagHref(term.slug)}${cursor ? `?cursor=${encodeURIComponent(cursor)}` : ""}`;

const breadcrumbJsonLd = {
	"@context": "https://schema.org",
	"@type": "BreadcrumbList",
	itemListElement: [
		{ "@type": "ListItem", position: 1, name: siteTitle, item: `${origin}/` },
		{ "@type": "ListItem", position: 2, name: "タグ一覧", item: `${origin}/tags/` },
		{ "@type": "ListItem", position: 3, name: term.label, item: `${origin}${tagHref(term.slug)}` },
	],
};
---

<Base
	title={`「${term.label}」の記事一覧`}
	description={`${siteTitle}の「${term.label}」タグが付いた記事一覧（${count}件）。`}
	canonical={canonical}
	robots={cursor ? "noindex, follow" : null}
>
	<script slot="head" type="application/ld+json" is:inline set:html={JSON.stringify(breadcrumbJsonLd)}></script>
	<section class="archive-section">
		<header class="archive-header">
			<nav class="breadcrumb" aria-label="パンくずリスト">
				<a href="/">ホーム</a>
				<span aria-hidden="true">/</span>
				<a href="/tags/">タグ一覧</a>
				<span aria-hidden="true">/</span>
				<span>{term.label}</span>
			</nav>
			<p class="outline-word archive-word" aria-hidden="true">Tag</p>
			<p class="kicker"><span class="tag-block">Tag</span></p>
			<h1 class="archive-title">#{term.label}</h1>
			<p class="meta archive-count">{count} articles</p>
		</header>

		{
			items.length === 0 ? (
				<p class="no-posts">このタグの記事はまだありません。</p>
			) : (
				<div class="posts-rows">
					{items.map(({ post, category, tags }, i) => (
						<PostCard
							variant="row"
							index={i + 1}
							title={post.data.title}
							excerpt={post.data.excerpt}
							featuredImage={post.data.featured_image}
							href={postHref(category.slug, post.id)}
							date={post.data.publishedAt ?? undefined}
							readingTime={getReadingTime(post.data.content)}
							category={category}
							tags={tags}
							headingLevel="h2"
						/>
					))}
				</div>
			)
		}

		{
			nextCursor && (
				<nav class="pagination" aria-label="ページ送り">
					<a href={`${tagHref(term.slug)}?cursor=${encodeURIComponent(nextCursor)}`} class="btn-ink" rel="next">
						次のページ →
					</a>
				</nav>
			)
		}
	</section>
</Base>

<style>
	.archive-section {
		max-width: 860px;
		margin: 0 auto;
		padding: var(--spacing-10) var(--spacing-6) var(--spacing-16);
	}

	.breadcrumb {
		display: flex;
		flex-wrap: wrap;
		gap: var(--spacing-2);
		font-family: var(--font-mono);
		font-size: 0.72rem;
		letter-spacing: 0.04em;
		color: var(--color-muted);
		margin-bottom: var(--spacing-6);
	}

	.breadcrumb a {
		color: var(--color-muted);
		text-decoration: none;
	}

	.breadcrumb a:hover {
		color: var(--color-brand);
	}

	.archive-header {
		position: relative;
		margin-bottom: var(--spacing-10);
		padding-bottom: var(--spacing-6);
		border-bottom: 2px solid var(--color-rule-strong);
		overflow: hidden;
	}

	.archive-word {
		position: absolute;
		right: -0.03em;
		bottom: 0.05em;
		font-size: clamp(5rem, 16vw, 11rem);
	}

	.archive-header > :not(.archive-word) {
		position: relative;
	}

	.archive-header .kicker {
		margin-bottom: var(--spacing-3);
	}

	.archive-title {
		font-size: clamp(2.2rem, 5vw, 3.2rem);
		font-weight: 900;
		line-height: 1.15;
		letter-spacing: -0.01em;
		margin-bottom: var(--spacing-3);
	}

	.no-posts {
		color: var(--color-muted);
	}

	.pagination {
		display: flex;
		justify-content: flex-end;
		margin-top: var(--spacing-10);
		padding-top: var(--spacing-6);
		border-top: 1px solid var(--color-border-subtle);
	}

	@media (max-width: 600px) {
		.archive-section {
			padding: var(--spacing-6) var(--spacing-4) var(--spacing-12);
		}

		.archive-title {
			font-size: var(--font-size-3xl);
		}
	}
</style>
