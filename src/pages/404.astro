---
import Base from "../layouts/Base.astro";
import { CATEGORIES } from "../utils/categories";
---

<Base title="ページが見つかりません" robots="noindex, nofollow">
	<div class="not-found">
		<p class="kicker">Error 404</p>
		<h1>ページが見つかりません</h1>
		<p class="lead">お探しのページは移動または削除された可能性があります。URLをご確認いただくか、以下からお探しください。</p>
		<div class="actions">
			<a href="/" class="btn-ink">トップへ戻る</a>
			<a href="/search" class="btn-ghost">記事を検索</a>
		</div>
		<nav class="cats" aria-label="カテゴリ">
			{CATEGORIES.map((c, i) => (
				<a href={`/${c.slug}`}>
					<span class="cat-no">{String(i + 1).padStart(2, "0")}</span>
					{c.label}
				</a>
			))}
		</nav>
	</div>
</Base>

<style>
	.not-found {
		padding: var(--spacing-20) var(--spacing-6) var(--spacing-24);
		max-width: 560px;
		margin: 0 auto;
	}

	.kicker {
		margin-bottom: var(--spacing-4);
	}

	h1 {
		font-size: var(--font-size-3xl);
		font-weight: 700;
		line-height: 1.3;
		margin-bottom: var(--spacing-4);
		padding-bottom: var(--spacing-4);
		border-bottom: 2px solid var(--color-rule-strong);
	}

	.lead {
		color: var(--color-text-secondary);
		line-height: 1.8;
		margin-bottom: var(--spacing-8);
	}

	.actions {
		display: flex;
		gap: var(--spacing-3);
		margin-bottom: var(--spacing-10);
	}

	.btn-ghost {
		display: inline-block;
		padding: 0.7rem 1.4rem;
		border: 1px solid var(--color-border);
		border-radius: var(--radius);
		color: var(--color-text);
		font-size: var(--font-size-sm);
		font-weight: 700;
		text-decoration: none;
	}

	.btn-ghost:hover {
		border-color: var(--color-rule-strong);
		color: var(--color-text);
	}

	.cats {
		display: grid;
		grid-template-columns: 1fr 1fr;
		border-top: 1px solid var(--color-border-subtle);
	}

	.cats a {
		display: flex;
		gap: var(--spacing-3);
		align-items: baseline;
		padding: var(--spacing-3) 0;
		border-bottom: 1px solid var(--color-border-subtle);
		color: var(--color-text);
		font-weight: 700;
		font-size: var(--font-size-sm);
		text-decoration: none;
	}

	.cats a:hover {
		color: var(--color-brand);
	}

	.cat-no {
		font-family: var(--font-mono);
		font-size: 0.72rem;
		font-weight: 400;
		color: var(--color-muted);
	}
</style>
