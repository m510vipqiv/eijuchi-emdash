---
/**
 * /{category}/  → category archive (news / guide / column / review)
 * /{slug}/      → static page (privacy, contact) when not a category
 *
 * Keeps the WordPress URL structure intact (要件定義書 §5).
 */
import {
	getTerm,
	getEmDashCollection,
	getTermsForEntries,
	getEmDashEntry,
	decodeSlug,
	getSiteSettings,
} from "emdash";
import { PortableText } from "emdash/ui";
import { Form as ContactForm } from "@emdash-cms/plugin-forms/ui";
import "@emdash-cms/plugin-forms/styles";
import Base from "../../layouts/Base.astro";
import PostCard from "../../components/PostCard.astro";
import { getReadingTime } from "../../utils/reading-time";
import { resolveBlogSiteIdentity, siteOrigin } from "../../utils/site-identity";
import { isCategorySlug, categoryLabel, postHref } from "../../utils/categories";

const slug = decodeSlug(Astro.params.category);
if (!slug) return Astro.redirect("/404");

const origin = siteOrigin(Astro.url);
const { siteTitle } = resolveBlogSiteIdentity(await getSiteSettings());

const PER_PAGE = 24;
const cursor = Astro.url.searchParams.get("cursor") ?? undefined;

// ---------- Static page fallback (/privacy, /contact) ----------
let page: any = null;
if (!isCategorySlug(slug)) {
	const { entry, cacheHint } = await getEmDashEntry("pages", slug);
	if (!entry) return Astro.redirect("/404");
	if (Astro.cache?.enabled) Astro.cache.set(cacheHint);
	page = entry;
}

// ---------- Category archive ----------
let term: any = null;
let items: Array<{
	post: any;
	tags: Array<{ slug: string; label: string }>;
}> = [];
let nextCursor: string | undefined;

if (!page) {
	term = await getTerm("category", slug);
	if (!term) return Astro.redirect("/404");

	const result = await getEmDashCollection("posts", {
		status: "published",
		where: { category: term.slug },
		orderBy: { published_at: "desc" },
		limit: PER_PAGE,
		cursor,
	});
	if (Astro.cache?.enabled) Astro.cache.set(result.cacheHint);
	nextCursor = result.nextCursor;

	const tagsByEntry = await getTermsForEntries(
		"posts",
		result.entries.map((p) => p.data.id),
		"tag",
	);
	items = result.entries.map((post) => ({
		post,
		tags: (tagsByEntry.get(post.data.id) ?? []).map((t) => ({ slug: t.slug, label: t.label })),
	}));
}

const label = term ? term.label : categoryLabel(slug);
const count = term?.count ?? items.length;
const archiveCanonical = `${origin}/${slug}${cursor ? `?cursor=${encodeURIComponent(cursor)}` : ""}`;

const breadcrumbJsonLd = {
	"@context": "https://schema.org",
	"@type": "BreadcrumbList",
	itemListElement: [
		{ "@type": "ListItem", position: 1, name: siteTitle, item: `${origin}/` },
		{
			"@type": "ListItem",
			position: 2,
			name: page ? page.data.title : label,
			item: `${origin}/${slug}`,
		},
	],
};
---

{
	page ? (
		<Base
			title={page.data.title}
			description={page.data.excerpt ?? null}
			canonical={`${origin}/${slug}`}
			content={{ collection: "pages", id: page.data.id, slug }}
		>
			<script slot="head" type="application/ld+json" is:inline set:html={JSON.stringify(breadcrumbJsonLd)}></script>
			<article class="page-article">
				<header class="page-header">
					<nav class="breadcrumb" aria-label="パンくずリスト">
						<a href="/">ホーム</a>
						<span aria-hidden="true">/</span>
						<span>{page.data.title}</span>
					</nav>
					<h1 class="page-title" {...page.edit.title}>{page.data.title}</h1>
				</header>
				<div class="page-content">
					<PortableText value={page.data.content} />
				</div>
				{
					slug === "contact" && (
						<section class="contact-form" aria-label="お問い合わせフォーム">
							<ContactForm id="contact" />
							<script is:inline>
								// Keep the Japanese submit label after the plugin's client script resets it.
								document.querySelectorAll("form.ec-form").forEach(function (f) {
									var b = f.querySelector(".ec-form-submit");
									if (b && !f.dataset.submitLabel) f.dataset.submitLabel = b.textContent.trim();
								});
							</script>
						</section>
					)
				}
			</article>
		</Base>
	) : (
		<Base
			title={`${label}の記事一覧`}
			description={`${siteTitle}の「${label}」カテゴリの記事一覧（${count}件）。`}
			canonical={archiveCanonical}
			robots={cursor ? "noindex, follow" : null}
		>
			<script slot="head" type="application/ld+json" is:inline set:html={JSON.stringify(breadcrumbJsonLd)}></script>
			<section class="archive-section">
				<header class="archive-header">
					<nav class="breadcrumb" aria-label="パンくずリスト">
						<a href="/">ホーム</a>
						<span aria-hidden="true">/</span>
						<span>{label}</span>
					</nav>
					<h1 class:list={["archive-title", `archive-title--${slug}`]}>
						<span class="archive-bar" aria-hidden="true"></span>
						{label}
					</h1>
					<p class="archive-count">{count}件の記事</p>
				</header>

				{items.length === 0 ? (
					<p class="no-posts">このカテゴリにはまだ記事がありません。</p>
				) : (
					<div class="posts-grid">
						{items.map(({ post, tags }) => (
							<PostCard
								title={post.data.title}
								excerpt={post.data.excerpt}
								featuredImage={post.data.featured_image}
								href={postHref(slug, post.id)}
								date={post.data.publishedAt ?? undefined}
								readingTime={getReadingTime(post.data.content)}
								category={{ slug, label }}
								tags={tags}
								headingLevel="h2"
							/>
						))}
					</div>
				)}

				{nextCursor && (
					<nav class="pagination" aria-label="ページ送り">
						<a href={`/${slug}?cursor=${encodeURIComponent(nextCursor)}`} class="pagination-next" rel="next">
							さらに読み込む →
						</a>
					</nav>
				)}
			</section>
		</Base>
	)
}

<style>
	.archive-section,
	.page-article {
		max-width: var(--wide-width);
		margin: 0 auto;
		padding: var(--spacing-10) var(--spacing-6) var(--spacing-20);
	}

	.page-article {
		max-width: var(--content-width);
	}

	.breadcrumb {
		display: flex;
		flex-wrap: wrap;
		gap: var(--spacing-2);
		font-size: var(--font-size-xs);
		color: var(--color-muted);
		margin-bottom: var(--spacing-4);
	}

	.breadcrumb a {
		color: var(--color-muted);
	}

	.breadcrumb a:hover {
		color: var(--color-brand);
	}

	.archive-header {
		margin-bottom: var(--spacing-12);
		padding-bottom: var(--spacing-8);
		border-bottom: 1px solid var(--color-border-subtle);
	}

	.archive-title {
		--cat-color: var(--color-brand);
		display: flex;
		align-items: center;
		gap: var(--spacing-4);
		font-size: var(--font-size-4xl);
		font-weight: var(--font-weight-display);
		margin-bottom: var(--spacing-2);
	}

	.archive-bar {
		width: 8px;
		height: 1em;
		border-radius: 4px;
		background: var(--cat-color);
	}

	.archive-title--news {
		--cat-color: light-dark(#d4127c, #ff4fa8);
	}
	.archive-title--guide {
		--cat-color: light-dark(#0b9fb5, #3ae0f2);
	}
	.archive-title--column {
		--cat-color: light-dark(#6d4fd6, #a48cff);
	}
	.archive-title--review {
		--cat-color: light-dark(#e0801a, #ffb35c);
	}

	.archive-count {
		font-size: var(--font-size-sm);
		color: var(--color-muted);
	}

	.posts-grid {
		display: grid;
		grid-template-columns: repeat(3, 1fr);
		gap: var(--spacing-12) var(--spacing-8);
	}

	.no-posts {
		color: var(--color-muted);
	}

	.pagination {
		display: flex;
		justify-content: center;
		margin-top: var(--spacing-16);
	}

	.pagination-next {
		display: inline-block;
		padding: var(--spacing-3) var(--spacing-8);
		border-radius: 999px;
		border: 1px solid var(--color-border);
		color: var(--color-text);
		font-weight: 600;
		text-decoration: none;
		transition:
			border-color var(--transition-fast),
			color var(--transition-fast),
			box-shadow var(--transition-fast);
	}

	.pagination-next:hover {
		border-color: var(--color-brand);
		color: var(--color-brand);
		box-shadow: 0 0 0 3px var(--color-brand-ring);
	}

	/* Static page */
	.page-header {
		margin-bottom: var(--spacing-8);
	}

	.page-title {
		font-size: clamp(var(--font-size-2xl), 4vw, var(--font-size-4xl));
		font-weight: var(--font-weight-display);
		line-height: 1.3;
	}

	.page-content {
		font-size: var(--font-size-base);
		line-height: 1.9;
	}

	.page-content :global(p) {
		margin-bottom: 1.5em;
	}

	.page-content :global(h2) {
		font-size: var(--font-size-2xl);
		margin-top: 2em;
		margin-bottom: 0.75em;
		padding-left: var(--spacing-4);
		border-left: 4px solid var(--color-brand);
	}

	.page-content :global(h3) {
		font-size: var(--font-size-xl);
		margin-top: 1.75em;
		margin-bottom: 0.5em;
	}

	.page-content :global(ul),
	.page-content :global(ol) {
		margin-bottom: 1.5em;
		padding-left: var(--spacing-5);
	}

	.page-content :global(li) {
		margin-bottom: 0.5em;
	}

	.page-content :global(a) {
		text-decoration: underline;
		text-underline-offset: 3px;
	}

	/* Contact form (EmDash Forms plugin) */
	.contact-form {
		margin-top: var(--spacing-10);
		padding: var(--spacing-8);
		border-radius: var(--radius-lg);
		border: 1px solid var(--color-border);
		background: var(--color-bg-subtle);
	}

	.contact-form :global(.ec-form) {
		--ec-form-gap: var(--spacing-5);
		--ec-form-field-border: 1px solid var(--color-border);
		--ec-form-field-radius: var(--radius);
		--ec-form-field-padding: 0.7rem 0.9rem;
		--ec-form-field-bg: var(--color-bg);
		--ec-form-error-color: #e0245e;
		--ec-form-required-color: var(--color-brand);
		--ec-form-help-color: var(--color-muted);
		--ec-form-submit-bg: var(--color-brand);
		--ec-form-submit-color: var(--color-on-brand);
		--ec-form-submit-radius: 999px;
		--ec-form-submit-padding: 0.8rem 2rem;
	}

	.contact-form :global(.ec-form-label) {
		font-weight: 700;
		font-size: var(--font-size-sm);
	}

	.contact-form :global(.ec-form-input) {
		font-family: var(--font-body);
		font-size: var(--font-size-base);
		color: var(--color-text);
		width: 100%;
		text-align: left;
		text-wrap: initial;
	}

	.contact-form :global(.ec-form-input:focus) {
		outline: none;
		border-color: var(--color-brand);
		box-shadow: 0 0 0 3px var(--color-brand-ring);
	}

	.contact-form :global(textarea.ec-form-input) {
		min-height: 180px;
	}

	.contact-form :global(.ec-form-submit) {
		font-family: var(--font-body);
		font-weight: 700;
		cursor: pointer;
		transition: background var(--transition-fast);
	}

	.contact-form :global(.ec-form-submit:hover) {
		background: var(--color-brand-hover);
	}

	.contact-form :global(.ec-form-status) {
		font-size: var(--font-size-sm);
	}

	@media (max-width: 900px) {
		.posts-grid {
			grid-template-columns: repeat(2, 1fr);
		}
	}

	@media (max-width: 600px) {
		.archive-section,
		.page-article {
			padding: var(--spacing-6) var(--spacing-4) var(--spacing-12);
		}

		.archive-title {
			font-size: var(--font-size-3xl);
		}

		.posts-grid {
			grid-template-columns: 1fr;
		}
	}
</style>
