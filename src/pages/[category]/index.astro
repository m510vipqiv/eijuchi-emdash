---
/**
 * /{category}/  → category archive (news / guide / column / review)
 * /{slug}/      → static page (privacy, contact) when not a category
 *
 * Keeps the WordPress URL structure intact (要件定義書 §5).
 */
import {
	getTerm,
	getEmDashCollection,
	getTermsForEntries,
	getEmDashEntry,
	decodeSlug,
	getSiteSettings,
} from "emdash";
import { PortableText } from "emdash/ui";
import ContentImage from "../../components/ContentImage.astro";
import ContentEmbed from "../../components/ContentEmbed.astro";
import ContentHtml from "../../components/ContentHtml.astro";
import { fallbackDescription } from "../../utils/description";
import { Form as ContactForm } from "@emdash-cms/plugin-forms/ui";
import "@emdash-cms/plugin-forms/styles";
import Base from "../../layouts/Base.astro";
import PostCard from "../../components/PostCard.astro";
import { getReadingTime } from "../../utils/reading-time";
import { resolveBlogSiteIdentity, siteOrigin } from "../../utils/site-identity";
import { isCategorySlug, categoryLabel, categoryEn, postHref } from "../../utils/categories";

const slug = decodeSlug(Astro.params.category);
if (!slug) return new Response(null, { status: 404 });

const origin = siteOrigin(Astro.url);
const { siteTitle } = resolveBlogSiteIdentity(await getSiteSettings());

const PER_PAGE = 24;
const cursor = Astro.url.searchParams.get("cursor") ?? undefined;

// ---------- Static page fallback (/privacy, /contact) ----------
let page: any = null;
if (!isCategorySlug(slug)) {
	const { entry, cacheHint } = await getEmDashEntry("pages", slug);
	if (!entry) return new Response(null, { status: 404 });
	if (Astro.cache?.enabled) Astro.cache.set(cacheHint);
	page = entry;
}

// ---------- Category archive ----------
let term: any = null;
let items: Array<{
	post: any;
	tags: Array<{ slug: string; label: string }>;
}> = [];
let nextCursor: string | undefined;

if (!page) {
	term = await getTerm("category", slug);
	if (!term) return new Response(null, { status: 404 });

	const result = await getEmDashCollection("posts", {
		status: "published",
		where: { category: term.slug },
		orderBy: { published_at: "desc" },
		limit: PER_PAGE,
		cursor,
	});
	if (Astro.cache?.enabled) Astro.cache.set(result.cacheHint);
	nextCursor = result.nextCursor;

	const tagsByEntry = await getTermsForEntries(
		"posts",
		result.entries.map((p) => p.data.id),
		"tag",
	);
	items = result.entries.map((post) => ({
		post,
		tags: (tagsByEntry.get(post.data.id) ?? []).map((t) => ({ slug: t.slug, label: t.label })),
	}));
}

const label = term ? term.label : categoryLabel(slug);
const count = term?.count ?? items.length;
const archiveCanonical = `${origin}/${slug}/${cursor ? `?cursor=${encodeURIComponent(cursor)}` : ""}`;

const breadcrumbJsonLd = {
	"@context": "https://schema.org",
	"@type": "BreadcrumbList",
	itemListElement: [
		{ "@type": "ListItem", position: 1, name: siteTitle, item: `${origin}/` },
		{
			"@type": "ListItem",
			position: 2,
			name: page ? page.data.title : label,
			item: `${origin}/${slug}/`,
		},
	],
};
---

{
	page ? (
		<Base
			title={page.data.title}
			description={fallbackDescription(page.data.excerpt, page.data.content) || `${siteTitle}の${page.data.title}ページ。`}
			canonical={`${origin}/${slug}/`}
			content={{ collection: "pages", id: page.data.id, slug }}
		>
			<script slot="head" type="application/ld+json" is:inline set:html={JSON.stringify(breadcrumbJsonLd)}></script>
			<article class="page-article">
				<header class="page-header">
					<nav class="breadcrumb" aria-label="パンくずリスト">
						<a href="/">ホーム</a>
						<span aria-hidden="true">/</span>
						<span>{page.data.title}</span>
					</nav>
					<h1 class="page-title" {...page.edit.title}>{page.data.title}</h1>
				</header>
				<div class="page-content">
					<PortableText
						value={page.data.content}
						components={{ type: { image: ContentImage, embed: ContentEmbed, htmlBlock: ContentHtml } }}
					/>
				</div>
				{
					slug === "contact" && (
						<section class="contact-form" aria-label="お問い合わせフォーム">
							<ContactForm id="contact" />
							<script is:inline>
								// Keep the Japanese submit label after the plugin's client script resets it.
								document.querySelectorAll("form.ec-form").forEach(function (f) {
									var b = f.querySelector(".ec-form-submit");
									if (b && !f.dataset.submitLabel) f.dataset.submitLabel = b.textContent.trim();
								});
							</script>
						</section>
					)
				}
			</article>
		</Base>
	) : (
		<Base
			title={`${label}の記事一覧`}
			description={`${siteTitle}の「${label}」カテゴリの記事一覧（${count}件）。`}
			canonical={archiveCanonical}
			robots={cursor ? "noindex, follow" : null}
		>
			<script slot="head" type="application/ld+json" is:inline set:html={JSON.stringify(breadcrumbJsonLd)}></script>
			<section class="archive-section">
				<header class="archive-header">
					<nav class="breadcrumb" aria-label="パンくずリスト">
						<a href="/">ホーム</a>
						<span aria-hidden="true">/</span>
						<span>{label}</span>
					</nav>
					<p class="outline-word archive-word" aria-hidden="true">{categoryEn(slug)}</p>
					<p class="kicker"><span class="tag-block">{categoryEn(slug)}</span></p>
					<h1 class="archive-title">{label}</h1>
					<p class="meta archive-count">{count} articles</p>
				</header>

				{items.length === 0 ? (
					<p class="no-posts">このカテゴリにはまだ記事がありません。</p>
				) : (
					<div class="posts-rows">
						{items.map(({ post, tags }, i) => (
							<PostCard
								variant="row"
								index={i + 1}
								title={post.data.title}
								excerpt={post.data.excerpt}
								featuredImage={post.data.featured_image}
								href={postHref(slug, post.id)}
								date={post.data.publishedAt ?? undefined}
								readingTime={getReadingTime(post.data.content)}
								category={{ slug, label }}
								tags={tags}
								headingLevel="h2"
							/>
						))}
					</div>
				)}

				{nextCursor && (
					<nav class="pagination" aria-label="ページ送り">
						<a href={`/${slug}/?cursor=${encodeURIComponent(nextCursor)}`} class="btn-ink" rel="next">
							次のページ →
						</a>
					</nav>
				)}
			</section>
		</Base>
	)
}

<style>
	.archive-section,
	.page-article {
		max-width: var(--wide-width);
		margin: 0 auto;
		padding: var(--spacing-10) var(--spacing-6) var(--spacing-16);
	}

	.archive-section {
		max-width: 860px;
	}

	.page-article {
		max-width: var(--content-width);
	}

	.breadcrumb {
		display: flex;
		flex-wrap: wrap;
		gap: var(--spacing-2);
		font-family: var(--font-mono);
		font-size: 0.72rem;
		letter-spacing: 0.04em;
		color: var(--color-muted);
		margin-bottom: var(--spacing-6);
	}

	.breadcrumb a {
		color: var(--color-muted);
		text-decoration: none;
	}

	.breadcrumb a:hover {
		color: var(--color-brand);
	}

	.archive-header {
		position: relative;
		margin-bottom: var(--spacing-10);
		padding-bottom: var(--spacing-6);
		border-bottom: 2px solid var(--color-rule-strong);
		overflow: hidden;
	}

	.archive-word {
		position: absolute;
		right: -0.03em;
		bottom: 0.05em;
		font-size: clamp(5rem, 16vw, 11rem);
	}

	.archive-header > :not(.archive-word) {
		position: relative;
	}

	.archive-header .kicker {
		margin-bottom: var(--spacing-3);
	}

	.archive-title {
		font-size: clamp(2.4rem, 5vw, 3.4rem);
		font-weight: 900;
		line-height: 1.15;
		letter-spacing: -0.01em;
		margin-bottom: var(--spacing-3);
	}

	.no-posts {
		color: var(--color-muted);
	}

	.pagination {
		display: flex;
		justify-content: flex-end;
		margin-top: var(--spacing-10);
		padding-top: var(--spacing-6);
		border-top: 1px solid var(--color-border-subtle);
	}

	/* Static page */
	.page-header {
		margin-bottom: var(--spacing-8);
		padding-bottom: var(--spacing-6);
		border-bottom: 2px solid var(--color-rule-strong);
	}

	.page-title {
		font-size: clamp(var(--font-size-2xl), 4vw, var(--font-size-4xl));
		font-weight: 700;
		line-height: 1.3;
	}

	.page-content {
		font-size: var(--font-size-base);
		line-height: 1.9;
	}

	.page-content :global(p) {
		margin-bottom: 1.5em;
	}

	.page-content :global(h2) {
		font-size: var(--font-size-xl);
		margin-top: 2.2em;
		margin-bottom: 0.8em;
		padding-bottom: 0.4em;
		border-bottom: 1px solid var(--color-rule-strong);
	}

	.page-content :global(h3) {
		font-size: var(--font-size-lg);
		margin-top: 1.75em;
		margin-bottom: 0.5em;
	}

	.page-content :global(ul),
	.page-content :global(ol) {
		margin-bottom: 1.5em;
		padding-left: var(--spacing-5);
	}

	.page-content :global(li) {
		margin-bottom: 0.5em;
	}

	/* Contact form (EmDash Forms plugin) */
	.contact-form {
		margin-top: var(--spacing-10);
		padding-top: var(--spacing-8);
		border-top: 2px solid var(--color-rule-strong);
	}

	.contact-form :global(.ec-form) {
		--ec-form-gap: var(--spacing-5);
		--ec-form-field-border: 1px solid var(--color-border);
		--ec-form-field-radius: var(--radius);
		--ec-form-field-padding: 0.7rem 0.9rem;
		--ec-form-field-bg: transparent;
		--ec-form-error-color: var(--color-brand);
		--ec-form-required-color: var(--color-brand);
		--ec-form-help-color: var(--color-muted);
		--ec-form-submit-bg: var(--color-ink-fill);
		--ec-form-submit-color: var(--color-on-ink);
		--ec-form-submit-radius: var(--radius);
		--ec-form-submit-padding: 0.8rem 2rem;
	}

	.contact-form :global(.ec-form-label) {
		font-weight: 700;
		font-size: var(--font-size-sm);
	}

	.contact-form :global(.ec-form-input) {
		font-family: var(--font-body);
		font-size: var(--font-size-base);
		color: var(--color-text);
		width: 100%;
		text-align: left;
		text-wrap: initial;
	}

	.contact-form :global(.ec-form-input:focus) {
		outline: none;
		border-color: var(--color-rule-strong);
		box-shadow: none;
	}

	.contact-form :global(textarea.ec-form-input) {
		min-height: 180px;
	}

	.contact-form :global(.ec-form-submit) {
		font-family: var(--font-body);
		font-weight: 700;
		cursor: pointer;
		border: 1px solid var(--color-ink-fill);
		transition:
			background var(--transition-fast),
			color var(--transition-fast);
	}

	.contact-form :global(.ec-form-submit:hover) {
		background: transparent;
		color: var(--color-text);
	}

	.contact-form :global(.ec-form-status) {
		font-size: var(--font-size-sm);
	}

	@media (max-width: 600px) {
		.archive-section,
		.page-article {
			padding: var(--spacing-6) var(--spacing-4) var(--spacing-12);
		}

		.archive-title {
			font-size: var(--font-size-3xl);
		}
	}
</style>
