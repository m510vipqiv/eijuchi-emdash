---
export const prerender = false;

import { search } from "emdash";
import Base from "../layouts/Base.astro";

const query = Astro.url.searchParams.get("q")?.trim() || "";

// FTS-backed search(); results link via /posts/{slug} which 301s to the
// canonical /{category}/{slug} URL.
const { items: results } = query
	? await search(query, { collections: ["posts"], limit: 30 })
	: { items: [] };
---

<Base title={query ? `「${query}」の検索結果` : "検索"} description="サイト内検索" robots="noindex, follow">
	<section class="search-page">
		<header class="page-header">
			<p class="kicker">Search</p>
			<h1 class="search-title">サイト内検索</h1>
		</header>

		<form method="get" action="/search" class="search-form" role="search">
			<input
				type="search"
				name="q"
				value={query}
				placeholder="キーワードを入力"
				class="search-input"
				aria-label="検索キーワード"
				autofocus
			/>
			<button type="submit" class="search-button">検索</button>
		</form>

		{
			query && (
				<p class="search-summary">
					{results.length === 0
						? `「${query}」に一致する記事は見つかりませんでした。`
						: `「${query}」の検索結果: ${results.length}件`}
				</p>
			)
		}

		{
			results.length > 0 && (
				<ol class="search-results">
					{results.map((result) => (
						<li class="search-result">
							<a href={`/posts/${result.slug ?? result.id}`} class="result-link">
								<h2 class="result-title">{result.title ?? "無題"}</h2>
								{result.snippet && <p class="result-snippet" set:html={result.snippet} />}
							</a>
						</li>
					))}
				</ol>
			)
		}

		{!query && <p class="search-hint">記事タイトルや本文からキーワードで検索できます。</p>}
	</section>
</Base>

<style>
	.search-page {
		max-width: var(--content-width);
		margin: 0 auto;
		padding: var(--spacing-10) var(--spacing-6) var(--spacing-20);
	}

	.page-header {
		margin-bottom: var(--spacing-8);
		padding-bottom: var(--spacing-6);
		border-bottom: 2px solid var(--color-rule-strong);
	}

	.page-header .kicker {
		margin-bottom: var(--spacing-2);
	}

	.search-title {
		font-size: var(--font-size-4xl);
		font-weight: 700;
		line-height: 1.2;
	}

	.search-form {
		display: flex;
		gap: var(--spacing-2);
		margin-bottom: var(--spacing-8);
	}

	.search-input {
		flex: 1;
		padding: var(--spacing-3) var(--spacing-4);
		font-family: var(--font-body);
		font-size: var(--font-size-base);
		border: 1px solid var(--color-border);
		border-radius: var(--radius);
		background: transparent;
		color: var(--color-text);
	}

	.search-input:focus {
		outline: none;
		border-color: var(--color-rule-strong);
	}

	.search-button {
		padding: var(--spacing-3) var(--spacing-6);
		font-family: var(--font-body);
		font-size: var(--font-size-base);
		background: var(--color-ink-fill);
		color: var(--color-on-ink);
		border: 1px solid var(--color-ink-fill);
		border-radius: var(--radius);
		cursor: pointer;
		font-weight: 700;
	}

	.search-button:hover {
		background: transparent;
		color: var(--color-text);
	}

	.search-summary,
	.search-hint {
		color: var(--color-muted);
		margin-bottom: var(--spacing-6);
	}

	.search-results {
		list-style: none;
		display: flex;
		flex-direction: column;
	}

	.search-result {
		padding: var(--spacing-6) 0;
		border-bottom: 1px solid var(--color-border-subtle);
	}

	.search-result:first-child {
		padding-top: 0;
	}

	.result-link {
		display: block;
		text-decoration: none;
		color: inherit;
	}

	.result-title {
		font-size: var(--font-size-lg);
		font-weight: var(--font-weight-heading);
		line-height: var(--leading-snug);
		margin-bottom: var(--spacing-2);
		transition: color var(--transition-fast);
	}

	.result-link:hover .result-title {
		color: var(--color-brand);
	}

	.result-snippet {
		font-size: var(--font-size-base);
		line-height: var(--leading-relaxed);
		color: var(--color-text-secondary);
	}

	.result-snippet :global(mark) {
		background: transparent;
		color: inherit;
		font-weight: 700;
		text-decoration: underline;
		text-decoration-color: var(--color-brand);
		text-underline-offset: 3px;
	}

	@media (max-width: 600px) {
		.search-page {
			padding: var(--spacing-6) var(--spacing-4) var(--spacing-12);
		}
	}
</style>
