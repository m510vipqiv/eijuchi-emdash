---
/**
 * /articles — every published post, newest first, cursor-paginated.
 * (WordPress /posts/ and /top/ 301 here.)
 */
import { getEmDashCollection, getTermsForEntries, getSiteSettings } from "emdash";
import Base from "../layouts/Base.astro";
import { getReadingTime } from "../utils/reading-time";
import { resolveBlogSiteIdentity, siteOrigin } from "../utils/site-identity";
import { primaryCategory, categoryLabel, categoryEn, postHref, formatDateJa, isoDate } from "../utils/categories";

const PER_PAGE = 30;
const cursor = Astro.url.searchParams.get("cursor") ?? undefined;
const origin = siteOrigin(Astro.url);
const { siteTitle } = resolveBlogSiteIdentity(await getSiteSettings());

const { entries: posts, cacheHint, nextCursor } = await getEmDashCollection("posts", {
	status: "published",
	orderBy: { published_at: "desc" },
	limit: PER_PAGE,
	cursor,
});
if (Astro.cache?.enabled) Astro.cache.set(cacheHint);

const ids = posts.map((p) => p.data.id);
const [catsByEntry, tagsByEntry] = await Promise.all([
	getTermsForEntries("posts", ids, "category"),
	getTermsForEntries("posts", ids, "tag"),
]);

const rows = posts.map((post) => {
	const cat = primaryCategory(catsByEntry.get(post.data.id));
	return {
		post,
		cat,
		catLabel: categoryLabel(cat),
		tags: (tagsByEntry.get(post.data.id) ?? []).slice(0, 3),
	};
});
---

<Base
	title="記事一覧"
	description={`${siteTitle}の全記事を新着順に掲載しています。`}
	canonical={`${origin}/articles${cursor ? `?cursor=${encodeURIComponent(cursor)}` : ""}`}
	robots={cursor ? "noindex, follow" : null}
>
	<div class="posts-page">
		<header class="page-header">
			<p class="outline-word page-word" aria-hidden="true">Index</p>
			<p class="kicker"><span class="tag-block">Index</span></p>
			<h1 class="page-title">記事一覧</h1>
			<p class="meta page-description">新着順{cursor ? "・続き" : ""}</p>
		</header>

		{
			posts.length === 0 ? (
				<p class="empty">記事がまだありません。</p>
			) : (
				<div class="posts-list">
					{rows.map(({ post, cat, catLabel, tags }) => (
						<article class="post-item">
							<p class="meta post-meta">
								{post.data.publishedAt && (
									<time datetime={isoDate(post.data.publishedAt)}>{formatDateJa(post.data.publishedAt)}</time>
								)}
								<a href={`/${cat}`} class="cat-word">{categoryEn(cat)}<span class="cat-ja">{catLabel}</span></a>
								<span>{getReadingTime(post.data.content)} min</span>
							</p>
							<div class="post-body">
								<h2 class="post-title">
									<a href={postHref(cat, post.id)}>{post.data.title}</a>
								</h2>
								{post.data.excerpt && <p class="post-excerpt">{post.data.excerpt}</p>}
								{tags.length > 0 && (
									<p class="post-tags">
										{tags.map((t) => (
											<a href={`/tag/${encodeURIComponent(t.slug)}`} class="tag-pill">
												{t.label}
											</a>
										))}
									</p>
								)}
							</div>
						</article>
					))}
				</div>
			)
		}

		{
			nextCursor && (
				<nav class="pagination" aria-label="ページ送り">
					<a href={`/articles?cursor=${encodeURIComponent(nextCursor)}`} class="btn-ink" rel="next">
						次のページ →
					</a>
				</nav>
			)
		}
	</div>
</Base>

<style>
	.posts-page {
		max-width: 860px;
		margin: 0 auto;
		padding: var(--spacing-10) var(--spacing-6) var(--spacing-16);
	}

	.page-header {
		position: relative;
		margin-bottom: var(--spacing-10);
		padding-bottom: var(--spacing-6);
		border-bottom: 2px solid var(--color-rule-strong);
		overflow: hidden;
	}

	.page-word {
		position: absolute;
		right: -0.03em;
		bottom: 0.05em;
		font-size: clamp(5rem, 16vw, 11rem);
	}

	.page-header > :not(.page-word) {
		position: relative;
	}

	.page-header .kicker {
		margin-bottom: var(--spacing-3);
	}

	.page-title {
		font-size: clamp(2.4rem, 5vw, 3.4rem);
		font-weight: 900;
		line-height: 1.15;
		letter-spacing: -0.01em;
		margin-bottom: var(--spacing-3);
	}

	.empty {
		color: var(--color-muted);
	}

	.posts-list {
		display: flex;
		flex-direction: column;
	}

	.post-item {
		display: grid;
		grid-template-columns: 200px minmax(0, 1fr);
		gap: var(--spacing-6);
		padding: var(--spacing-5) 0;
		border-bottom: 1px solid var(--color-border-subtle);
	}

	.post-meta {
		display: flex;
		flex-direction: column;
		gap: var(--spacing-1);
		padding-top: 0.35em;
	}

	.post-meta time {
		color: var(--color-text);
	}

	.cat-word {
		font-family: var(--font-display);
		font-weight: 700;
		font-size: 1.1rem;
		line-height: 1;
		text-transform: uppercase;
		letter-spacing: 0.03em;
		color: var(--color-brand);
		text-decoration: none;
		margin: 0.15em 0;
	}

	.cat-ja {
		font-family: var(--font-body);
		font-size: 0.68rem;
		font-weight: 500;
		letter-spacing: 0;
		color: var(--color-muted);
		margin-left: 0.4em;
	}

	.cat-word:hover {
		color: var(--color-text);
	}

	.post-title {
		font-size: var(--font-size-lg);
		font-weight: 700;
		line-height: 1.45;
		margin-bottom: var(--spacing-2);
	}

	.post-title a {
		color: var(--color-text);
		text-decoration: none;
	}

	.post-title a:hover {
		text-decoration: underline;
		text-decoration-color: var(--color-brand);
		text-decoration-thickness: 2px;
		text-underline-offset: 4px;
	}

	.post-excerpt {
		font-size: var(--font-size-sm);
		line-height: 1.75;
		color: var(--color-text-secondary);
		display: -webkit-box;
		-webkit-line-clamp: 2;
		-webkit-box-orient: vertical;
		overflow: hidden;
	}

	.post-tags {
		display: flex;
		flex-wrap: wrap;
		gap: 0 var(--spacing-3);
		margin-top: var(--spacing-2);
	}

	.pagination {
		display: flex;
		justify-content: flex-end;
		margin-top: var(--spacing-10);
	}

	@media (max-width: 700px) {
		.posts-page {
			padding: var(--spacing-6) var(--spacing-4) var(--spacing-12);
		}

		.page-title {
			font-size: var(--font-size-3xl);
		}

		.post-item {
			grid-template-columns: 1fr;
			gap: var(--spacing-2);
		}

		.post-meta {
			flex-direction: row;
			flex-wrap: wrap;
			gap: 0 var(--spacing-3);
			padding-top: 0;
		}

		.post-title {
			font-size: var(--font-size-base);
		}
	}
</style>
