---
import { getEmDashCollection, getTermsForEntries, getSiteSettings } from "emdash";
import { Image } from "emdash/ui";
import Base from "../layouts/Base.astro";
import PostCard from "../components/PostCard.astro";
import { getReadingTime } from "../utils/reading-time";
import { resolveBlogSiteIdentity, siteOrigin } from "../utils/site-identity";
import {
	CATEGORIES,
	primaryCategory,
	categoryLabel,
	postHref,
	formatDateJa,
	isoDate,
} from "../utils/categories";

// 1 featured + 9 grid. The DB does the slicing.
const GRID_SIZE = 9;
const POSTS_PER_PAGE = GRID_SIZE + 1;

const [{ entries: posts, cacheHint }, settings] = await Promise.all([
	getEmDashCollection("posts", {
		status: "published",
		orderBy: { published_at: "desc" },
		limit: POSTS_PER_PAGE,
	}),
	getSiteSettings(),
]);
const { siteTitle, siteTagline } = resolveBlogSiteIdentity(settings);

if (Astro.cache?.enabled) Astro.cache.set(cacheHint);

const featuredPost = posts.find((p) => p.data.featured_image) ?? posts[0];
const gridPosts = posts.filter((p) => p !== featuredPost).slice(0, GRID_SIZE);

// One batched query each for categories and tags across all shown posts.
const ids = posts.map((p) => p.data.id);
const [catsByEntry, tagsByEntry] = await Promise.all([
	getTermsForEntries("posts", ids, "category"),
	getTermsForEntries("posts", ids, "tag"),
]);

function catOf(id: string) {
	const slug = primaryCategory(catsByEntry.get(id));
	return { slug, label: categoryLabel(slug) };
}

const featuredCat = featuredPost ? catOf(featuredPost.data.id) : null;
const featuredTags = featuredPost
	? (tagsByEntry.get(featuredPost.data.id) ?? []).map((t) => ({ slug: t.slug, label: t.label }))
	: [];

const origin = siteOrigin(Astro.url);
const websiteJsonLd = {
	"@context": "https://schema.org",
	"@type": "WebSite",
	name: siteTitle,
	url: `${origin}/`,
	description: siteTagline,
	inLanguage: "ja",
	potentialAction: {
		"@type": "SearchAction",
		target: { "@type": "EntryPoint", urlTemplate: `${origin}/search?q={search_term_string}` },
		"query-input": "required name=search_term_string",
	},
};
---

<Base title={siteTitle} pageTitle={siteTitle} description={siteTagline} canonical={`${origin}/`}>
	<script slot="head" type="application/ld+json" is:inline set:html={JSON.stringify(websiteJsonLd)}></script>

	{
		posts.length === 0 ? (
			<section class="empty-state">
				<h2>記事がまだありません</h2>
				<p>管理画面から最初の記事を作成してください。</p>
				<a href="/_emdash/admin/content/posts/new" class="btn">記事を作成</a>
			</section>
		) : (
			<div class="home-content">
				{featuredPost && (
					<section class="featured-section" aria-label="注目記事">
						<div class="featured-grid">
							<a href={postHref(featuredCat!.slug, featuredPost.id)} class="featured-image-link">
								<div class="featured-image">
									{featuredPost.data.featured_image ? (
										<Image image={featuredPost.data.featured_image} />
									) : (
										<div class="featured-placeholder">永住地</div>
									)}
								</div>
							</a>
							<div class="featured-content">
								<div class="featured-meta">
									<a href={`/${featuredCat!.slug}`} class:list={["cat-chip", `cat-chip--${featuredCat!.slug}`]}>
										{featuredCat!.label}
									</a>
									{featuredPost.data.publishedAt && (
										<time datetime={isoDate(featuredPost.data.publishedAt)}>
											{formatDateJa(featuredPost.data.publishedAt)}
										</time>
									)}
									<span>約{getReadingTime(featuredPost.data.content)}分</span>
								</div>
								<a href={postHref(featuredCat!.slug, featuredPost.id)} class="featured-title-link">
									<h1 class="featured-title">{featuredPost.data.title}</h1>
								</a>
								{featuredPost.data.excerpt && (
									<p class="featured-excerpt">{featuredPost.data.excerpt}</p>
								)}
								{featuredTags.length > 0 && (
									<div class="featured-tags">
										{featuredTags.slice(0, 4).map((tag) => (
											<a href={`/tag/${tag.slug}`} class="tag-pill">
												{tag.label}
											</a>
										))}
									</div>
								)}
							</div>
						</div>
					</section>
				)}

				<nav class="category-strip" aria-label="カテゴリ">
					{CATEGORIES.map((c) => (
						<a href={`/${c.slug}`} class:list={["category-tile", `category-tile--${c.slug}`]}>
							<span class="category-tile-label">{c.label}</span>
							<span class="category-tile-arrow" aria-hidden="true">→</span>
						</a>
					))}
				</nav>

				{gridPosts.length > 0 && (
					<section class="posts-section">
						<header class="section-header">
							<h2 class="section-title"><span class="glitch-bar" aria-hidden="true"></span>最新記事</h2>
							<a href="/articles" class="section-link">すべての記事 →</a>
						</header>
						<div class="posts-grid">
							{gridPosts.map((post) => {
								const cat = catOf(post.data.id);
								return (
									<PostCard
										title={post.data.title ?? "無題"}
										excerpt={post.data.excerpt}
										featuredImage={post.data.featured_image}
										href={postHref(cat.slug, post.id)}
										date={post.data.publishedAt ?? undefined}
										readingTime={getReadingTime(post.data.content)}
										category={cat}
										tags={(tagsByEntry.get(post.data.id) ?? []).map((t) => ({ slug: t.slug, label: t.label }))}
									/>
								);
							})}
						</div>
					</section>
				)}
			</div>
		)
	}
</Base>

<style>
	.home-content {
		max-width: var(--wide-width);
		margin: 0 auto;
		padding: var(--spacing-12) var(--spacing-6) var(--spacing-20);
	}

	/* Featured */
	.featured-section {
		margin-bottom: var(--spacing-12);
	}

	.featured-grid {
		display: grid;
		grid-template-columns: 7fr 5fr;
		gap: var(--spacing-10);
		align-items: center;
	}

	.featured-image-link {
		display: block;
	}

	.featured-image {
		position: relative;
		overflow: hidden;
		border-radius: var(--radius-lg);
		background: var(--color-surface);
		border: 1px solid var(--color-border-subtle);
		box-shadow: var(--shadow-card);
	}

	.featured-image::after {
		content: "";
		position: absolute;
		inset: auto 0 0 0;
		height: 4px;
		background: var(--gradient-glitch);
	}

	.featured-image img,
	.featured-placeholder {
		width: 100%;
		height: auto;
		aspect-ratio: 16 / 9;
		object-fit: cover;
		transition: transform 0.5s cubic-bezier(0.2, 0.7, 0.2, 1);
	}

	.featured-placeholder {
		display: grid;
		place-items: center;
		font-weight: 800;
		font-size: var(--font-size-4xl);
		letter-spacing: 0.2em;
		color: var(--color-muted);
	}

	.featured-image-link:hover .featured-image img,
	.featured-grid:has(.featured-title-link:hover) .featured-image img {
		transform: scale(1.03);
	}

	.featured-content {
		display: flex;
		flex-direction: column;
		gap: var(--spacing-4);
	}

	.featured-meta {
		display: flex;
		align-items: center;
		flex-wrap: wrap;
		gap: var(--spacing-2) var(--spacing-3);
		font-size: var(--font-size-sm);
		color: var(--color-muted);
	}

	.featured-title-link {
		text-decoration: none;
		color: inherit;
	}

	.featured-title {
		font-size: clamp(var(--font-size-2xl), 3.2vw, var(--font-size-4xl));
		font-weight: var(--font-weight-display);
		line-height: 1.25;
		transition: color var(--transition-fast);
	}

	.featured-title-link:hover .featured-title,
	.featured-grid:has(.featured-image-link:hover) .featured-title {
		color: var(--color-brand);
	}

	.featured-excerpt {
		font-size: var(--font-size-base);
		line-height: var(--leading-relaxed);
		color: var(--color-text-secondary);
		display: -webkit-box;
		-webkit-line-clamp: 4;
		-webkit-box-orient: vertical;
		overflow: hidden;
	}

	.featured-tags {
		display: flex;
		flex-wrap: wrap;
		gap: var(--spacing-2);
	}

	/* Category strip */
	.category-strip {
		display: grid;
		grid-template-columns: repeat(4, 1fr);
		gap: var(--spacing-4);
		margin-bottom: var(--spacing-16);
	}

	.category-tile {
		--cat-color: var(--color-brand);
		display: flex;
		align-items: center;
		justify-content: space-between;
		padding: var(--spacing-4) var(--spacing-5);
		border-radius: var(--radius-lg);
		border: 1px solid var(--color-border);
		background: var(--color-bg);
		color: var(--color-text);
		text-decoration: none;
		font-weight: 700;
		position: relative;
		overflow: hidden;
		transition:
			transform var(--transition-base),
			box-shadow var(--transition-base),
			border-color var(--transition-base);
	}

	.category-tile::before {
		content: "";
		position: absolute;
		left: 0;
		top: 0;
		bottom: 0;
		width: 4px;
		background: var(--cat-color);
	}

	.category-tile:hover {
		transform: translateY(-2px);
		box-shadow: var(--shadow-card);
		border-color: color-mix(in srgb, var(--cat-color) 45%, var(--color-border));
		color: var(--color-text);
	}

	.category-tile-arrow {
		color: var(--cat-color);
		transition: transform var(--transition-fast);
	}

	.category-tile:hover .category-tile-arrow {
		transform: translateX(4px);
	}

	.category-tile--news {
		--cat-color: light-dark(#d4127c, #ff4fa8);
	}
	.category-tile--guide {
		--cat-color: light-dark(#0b9fb5, #3ae0f2);
	}
	.category-tile--column {
		--cat-color: light-dark(#6d4fd6, #a48cff);
	}
	.category-tile--review {
		--cat-color: light-dark(#e0801a, #ffb35c);
	}

	/* Section header */
	.section-header {
		display: flex;
		justify-content: space-between;
		align-items: baseline;
		margin-bottom: var(--spacing-8);
		padding-bottom: var(--spacing-4);
		border-bottom: 1px solid var(--color-border-subtle);
	}

	.section-title {
		display: flex;
		align-items: center;
		gap: var(--spacing-3);
		font-size: var(--font-size-xl);
		font-weight: 800;
	}

	.section-link {
		font-size: var(--font-size-sm);
		font-weight: 600;
		color: var(--color-brand);
		text-decoration: none;
	}

	.section-link:hover {
		color: var(--color-brand-hover);
	}

	.posts-grid {
		display: grid;
		grid-template-columns: repeat(3, 1fr);
		gap: var(--spacing-12) var(--spacing-8);
	}

	/* Empty state */
	.empty-state {
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: var(--spacing-3);
		text-align: center;
		padding: var(--spacing-20) var(--spacing-6);
		max-width: 400px;
		margin: 0 auto;
	}

	.empty-state p {
		color: var(--color-muted);
	}

	.btn {
		display: inline-block;
		margin-top: var(--spacing-4);
		padding: var(--spacing-3) var(--spacing-6);
		background: var(--color-brand);
		color: var(--color-on-brand);
		text-decoration: none;
		border-radius: 999px;
		font-size: var(--font-size-sm);
		font-weight: 600;
	}

	.btn:hover {
		background: var(--color-brand-hover);
		color: var(--color-on-brand);
	}

	@media (max-width: 900px) {
		.home-content {
			padding: var(--spacing-6) var(--spacing-4) var(--spacing-12);
		}

		.featured-grid {
			grid-template-columns: 1fr;
			gap: var(--spacing-6);
		}

		.category-strip {
			grid-template-columns: repeat(2, 1fr);
		}

		.posts-grid {
			grid-template-columns: repeat(2, 1fr);
			gap: var(--spacing-8) var(--spacing-6);
		}
	}

	@media (max-width: 600px) {
		.featured-title {
			font-size: var(--font-size-2xl);
		}

		.category-strip {
			gap: var(--spacing-3);
		}

		.category-tile {
			padding: var(--spacing-3) var(--spacing-4);
			font-size: var(--font-size-sm);
		}

		.posts-grid {
			grid-template-columns: 1fr;
			gap: var(--spacing-8);
		}
	}
</style>
