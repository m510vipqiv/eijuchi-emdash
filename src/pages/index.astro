---
import { getEmDashCollection, getTermsForEntries, getSiteSettings, getTaxonomyTerms } from "emdash";
import { Image } from "emdash/ui";
import Base from "../layouts/Base.astro";
import PostCard from "../components/PostCard.astro";
import { getReadingTime } from "../utils/reading-time";
import { resolveBlogSiteIdentity, siteOrigin } from "../utils/site-identity";
import {
	CATEGORIES,
	primaryCategory,
	categoryLabel,
	categoryEn,
	postHref,
	formatDateJa,
	isoDate,
} from "../utils/categories";

// 1 lead story + 6 cards + 6 ruled rows. The DB does the slicing.
const CARD_COUNT = 6;
const ROW_COUNT = 6;
const POSTS_PER_PAGE = 1 + CARD_COUNT + ROW_COUNT;

const [{ entries: posts, cacheHint }, settings, categoryTerms, tagTerms] = await Promise.all([
	getEmDashCollection("posts", {
		status: "published",
		orderBy: { published_at: "desc" },
		limit: POSTS_PER_PAGE,
	}),
	getSiteSettings(),
	getTaxonomyTerms("category"),
	getTaxonomyTerms("tag"),
]);
const { siteTitle, siteTagline } = resolveBlogSiteIdentity(settings);

if (Astro.cache?.enabled) Astro.cache.set(cacheHint);

const featuredPost = posts.find((p) => p.data.featured_image) ?? posts[0];
const rest = posts.filter((p) => p !== featuredPost);
const cardPosts = rest.slice(0, CARD_COUNT);
const rowPosts = rest.slice(CARD_COUNT, CARD_COUNT + ROW_COUNT);

// One batched query each for categories and tags across all shown posts.
const ids = posts.map((p) => p.data.id);
const [catsByEntry, tagsByEntry] = await Promise.all([
	getTermsForEntries("posts", ids, "category"),
	getTermsForEntries("posts", ids, "tag"),
]);

function catOf(id: string) {
	const slug = primaryCategory(catsByEntry.get(id));
	return { slug, label: categoryLabel(slug) };
}
function tagsOf(id: string) {
	return (tagsByEntry.get(id) ?? []).map((t) => ({ slug: t.slug, label: t.label }));
}

const featuredCat = featuredPost ? catOf(featuredPost.data.id) : null;
const featuredTags = featuredPost ? tagsOf(featuredPost.data.id) : [];

const categoryCounts = new Map(categoryTerms.map((t) => [t.slug, t.count ?? 0]));
const popularTags = tagTerms
	.filter((t) => (t.count ?? 0) > 0)
	.sort((a, b) => (b.count ?? 0) - (a.count ?? 0))
	.slice(0, 14);

const origin = siteOrigin(Astro.url);
const websiteJsonLd = {
	"@context": "https://schema.org",
	"@type": "WebSite",
	name: siteTitle,
	url: `${origin}/`,
	description: siteTagline,
	inLanguage: "ja",
	potentialAction: {
		"@type": "SearchAction",
		target: { "@type": "EntryPoint", urlTemplate: `${origin}/search?q={search_term_string}` },
		"query-input": "required name=search_term_string",
	},
};
---

<Base title={siteTitle} pageTitle={siteTitle} description={siteTagline} canonical={`${origin}/`}>
	<script slot="head" type="application/ld+json" is:inline set:html={JSON.stringify(websiteJsonLd)}></script>

	{
		posts.length === 0 ? (
			<section class="empty-state">
				<h2>記事がまだありません</h2>
				<p>管理画面から最初の記事を作成してください。</p>
				<a href="/_emdash/admin/content/posts/new" class="btn-ink">記事を作成</a>
			</section>
		) : (
			<div class="home-content">
				{featuredPost && (
					<section class="lead" aria-label="最新の注目記事">
						<p class="outline-word lead-word" aria-hidden="true">Latest</p>
						<p class="kicker lead-kicker">
							<a href={`/${featuredCat!.slug}`} class="tag-block">{categoryEn(featuredCat!.slug)}</a>
							<span class="lead-kicker-rule" aria-hidden="true" />
							<a href={`/${featuredCat!.slug}`}>{featuredCat!.label}</a>
						</p>
						<div class="lead-grid">
							<a href={postHref(featuredCat!.slug, featuredPost.id)} class="lead-image frame-ink frame-ink--brand" aria-hidden="true" tabindex="-1">
								{featuredPost.data.featured_image ? (
									<Image image={featuredPost.data.featured_image} />
								) : (
									<span class="lead-blank" />
								)}
							</a>
							<div class="lead-body">
								<h1 class="lead-title">
									<a href={postHref(featuredCat!.slug, featuredPost.id)}>{featuredPost.data.title}</a>
								</h1>
								{featuredPost.data.excerpt && <p class="lead-excerpt">{featuredPost.data.excerpt}</p>}
								<p class="meta lead-meta">
									{featuredPost.data.publishedAt && (
										<time datetime={isoDate(featuredPost.data.publishedAt)}>
											{formatDateJa(featuredPost.data.publishedAt)}
										</time>
									)}
									<span>{getReadingTime(featuredPost.data.content)} min read</span>
								</p>
								{featuredTags.length > 0 && (
									<p class="lead-tags">
										{featuredTags.slice(0, 4).map((tag) => (
											<a href={`/tag/${encodeURIComponent(tag.slug)}`} class="tag-pill">
												{tag.label}
											</a>
										))}
									</p>
								)}
								<a href={postHref(featuredCat!.slug, featuredPost.id)} class="btn-ink lead-cta">
									記事を読む
								</a>
							</div>
						</div>
					</section>
				)}

				<div class="home-columns">
					<div class="home-main">
						{cardPosts.length > 0 && (
							<section class="posts-section" aria-labelledby="latest-heading">
								<header class="section-head">
									<h2 id="latest-heading">新着記事</h2>
									<span class="section-word" aria-hidden="true">New</span>
									<a href="/articles" class="section-more">すべての記事 →</a>
								</header>
								<div class="posts-grid">
									{cardPosts.map((post) => (
										<PostCard
											title={post.data.title ?? "無題"}
											excerpt={post.data.excerpt}
											featuredImage={post.data.featured_image}
											href={postHref(catOf(post.data.id).slug, post.id)}
											date={post.data.publishedAt ?? undefined}
											readingTime={getReadingTime(post.data.content)}
											category={catOf(post.data.id)}
											tags={tagsOf(post.data.id)}
										/>
									))}
								</div>
							</section>
						)}

						{rowPosts.length > 0 && (
							<section class="posts-section" aria-labelledby="more-heading">
								<header class="section-head">
									<h2 id="more-heading">続けて読む</h2>
									<span class="section-word" aria-hidden="true">More</span>
									<a href="/articles" class="section-more">記事一覧 →</a>
								</header>
								<div class="posts-rows">
									{rowPosts.map((post, i) => (
										<PostCard
											variant="row"
											index={CARD_COUNT + i + 2}
											title={post.data.title ?? "無題"}
											excerpt={post.data.excerpt}
											featuredImage={post.data.featured_image}
											href={postHref(catOf(post.data.id).slug, post.id)}
											date={post.data.publishedAt ?? undefined}
											readingTime={getReadingTime(post.data.content)}
											category={catOf(post.data.id)}
											tags={tagsOf(post.data.id)}
										/>
									))}
								</div>
								<p class="rows-foot">
									<a href="/articles" class="btn-ink">もっと読む</a>
								</p>
							</section>
						)}
					</div>

					<aside class="home-rail" aria-label="サイド情報">
						<section class="rail-block">
							<h2 class="rail-head">カテゴリ</h2>
							<ul class="rail-list">
								{CATEGORIES.map((c, i) => (
									<li>
										<a href={`/${c.slug}`}>
											<span class="rail-no">{String(i + 1).padStart(2, "0")}</span>
											<span class="rail-label">
												<span class="rail-en">{c.en}</span>
												<span class="rail-ja">{c.label}</span>
											</span>
											<span class="rail-count">{categoryCounts.get(c.slug) ?? 0}</span>
										</a>
									</li>
								))}
							</ul>
						</section>

						{popularTags.length > 0 && (
							<section class="rail-block">
								<h2 class="rail-head">よく使うタグ</h2>
								<p class="rail-tags">
									{popularTags.map((t) => (
										<a href={`/tag/${encodeURIComponent(t.slug)}`} class="tag-pill">
											{t.label}
										</a>
									))}
								</p>
								<a href="/tags" class="rail-more">タグ一覧 →</a>
							</section>
						)}

						<section class="rail-block rail-about">
							<h2 class="rail-head">このサイトについて</h2>
							<p>{siteTagline}</p>
							<p class="rail-links">
								<a href="/rss.xml">RSS</a>
								<a href="/contact">お問い合わせ</a>
							</p>
						</section>
					</aside>
				</div>
			</div>
		)
	}
</Base>

<style>
	.home-content {
		max-width: var(--wide-width);
		margin: 0 auto;
		padding: var(--spacing-10) var(--spacing-6) var(--spacing-16);
	}

	/* ---- Lead story ---------------------------------------------- */
	.lead {
		position: relative;
		padding-bottom: var(--spacing-12);
		margin-bottom: var(--spacing-12);
		border-bottom: 1px solid var(--color-rule-strong);
	}

	.lead-word {
		position: absolute;
		right: -0.02em;
		top: -0.35em;
		font-size: clamp(4rem, 12vw, 9rem);
		z-index: 0;
	}

	.lead-kicker,
	.lead-grid {
		position: relative;
		z-index: 1;
	}

	.lead-kicker {
		display: flex;
		align-items: center;
		gap: var(--spacing-3);
		margin-bottom: var(--spacing-6);
	}

	.lead-kicker a:not(.tag-block) {
		color: var(--color-text);
		text-decoration: none;
		text-transform: none;
		letter-spacing: 0.04em;
	}

	.lead-kicker a:not(.tag-block):hover {
		color: var(--color-brand);
	}

	.lead-kicker-rule {
		width: 28px;
		height: 1px;
		background: var(--color-rule-strong);
	}

	.lead-grid {
		display: grid;
		grid-template-columns: 7fr 5fr;
		gap: var(--spacing-10);
		align-items: start;
	}

	.lead-image {
		display: block;
		aspect-ratio: 16 / 9;
		margin-right: 8px;
		transition: box-shadow var(--transition-base), transform var(--transition-base);
	}

	.lead:has(.lead-title a:hover) .lead-image,
	.lead-image:hover {
		box-shadow: 12px 12px 0 0 var(--color-brand);
		transform: translate(-2px, -2px);
	}

	.lead-image :global(img),
	.lead-blank {
		display: block;
		width: 100%;
		height: 100%;
		object-fit: cover;
	}

	.lead-blank {
		background: repeating-linear-gradient(-45deg, transparent 0 6px, var(--color-border-subtle) 6px 7px);
	}

	.lead-body {
		display: flex;
		flex-direction: column;
		gap: var(--spacing-4);
	}

	.lead-title {
		font-size: clamp(var(--font-size-2xl), 2.9vw, 2.4rem);
		font-weight: 900;
		line-height: 1.28;
		letter-spacing: -0.01em;
	}

	.lead-title a {
		color: var(--color-text);
		text-decoration: none;
	}

	.lead-title a:hover {
		text-decoration: underline;
		text-decoration-color: var(--color-brand);
		text-decoration-thickness: 2px;
		text-underline-offset: 5px;
	}

	.lead-excerpt {
		font-size: var(--font-size-base);
		line-height: 1.85;
		color: var(--color-text-secondary);
		display: -webkit-box;
		-webkit-line-clamp: 4;
		-webkit-box-orient: vertical;
		overflow: hidden;
	}

	.lead-meta {
		display: flex;
		gap: var(--spacing-3);
	}

	.lead-tags {
		display: flex;
		flex-wrap: wrap;
		gap: 0 var(--spacing-3);
	}

	.lead-cta {
		align-self: flex-start;
		margin-top: var(--spacing-2);
	}

	/* ---- Columns --------------------------------------------------- */
	.home-columns {
		display: grid;
		grid-template-columns: minmax(0, 1fr) 260px;
		gap: var(--spacing-16);
		align-items: start;
	}

	.posts-section + .posts-section {
		margin-top: var(--spacing-14, 3.5rem);
	}

	.posts-grid {
		display: grid;
		grid-template-columns: repeat(3, 1fr);
		gap: var(--spacing-10) var(--spacing-6);
	}

	.rows-foot {
		margin-top: var(--spacing-8);
		padding-top: var(--spacing-6);
		border-top: 1px solid var(--color-border-subtle);
	}

	/* ---- Rail ------------------------------------------------------ */
	.home-rail {
		position: sticky;
		top: var(--spacing-6);
		display: flex;
		flex-direction: column;
		gap: var(--spacing-10);
	}

	.rail-head {
		font-family: var(--font-mono);
		font-size: 0.7rem;
		font-weight: 500;
		letter-spacing: var(--tracking-wider);
		text-transform: uppercase;
		color: var(--color-muted);
		padding-bottom: var(--spacing-2);
		margin-bottom: var(--spacing-3);
		border-bottom: 2px solid var(--color-rule-strong);
	}

	.rail-list {
		list-style: none;
	}

	.rail-list a {
		display: grid;
		grid-template-columns: 2.2em 1fr auto;
		align-items: baseline;
		padding: var(--spacing-3) 0;
		border-bottom: 1px solid var(--color-border-subtle);
		color: var(--color-text);
		text-decoration: none;
		font-weight: 700;
		font-size: var(--font-size-sm);
	}

	.rail-label {
		display: flex;
		align-items: baseline;
		gap: 0.5em;
	}

	.rail-en {
		font-family: var(--font-display);
		font-weight: 800;
		font-size: 1.5rem;
		line-height: 1;
		text-transform: uppercase;
		letter-spacing: 0.01em;
	}

	.rail-ja {
		font-size: 0.72rem;
		font-weight: 500;
		color: var(--color-muted);
	}

	.rail-list a:hover .rail-en {
		color: var(--color-brand);
	}

	.rail-no,
	.rail-count {
		font-family: var(--font-mono);
		font-size: 0.72rem;
		font-weight: 400;
		color: var(--color-muted);
		letter-spacing: 0.04em;
	}

	.rail-tags {
		display: flex;
		flex-wrap: wrap;
		gap: var(--spacing-1) var(--spacing-3);
		line-height: 1.9;
	}

	.rail-more {
		display: inline-block;
		margin-top: var(--spacing-3);
		font-family: var(--font-mono);
		font-size: 0.72rem;
		color: var(--color-muted);
		text-decoration: none;
	}

	.rail-more:hover {
		color: var(--color-brand);
	}

	.rail-about p {
		font-size: var(--font-size-sm);
		line-height: 1.8;
		color: var(--color-text-secondary);
	}

	.rail-links {
		display: flex;
		gap: var(--spacing-4);
		margin-top: var(--spacing-3);
	}

	.rail-links a {
		font-family: var(--font-mono);
		font-size: 0.72rem;
	}

	/* ---- Empty state ------------------------------------------------ */
	.empty-state {
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: var(--spacing-3);
		text-align: center;
		padding: var(--spacing-20) var(--spacing-6);
		max-width: 400px;
		margin: 0 auto;
	}

	.empty-state p {
		color: var(--color-muted);
	}

	@media (max-width: 1000px) {
		.home-columns {
			grid-template-columns: 1fr;
			gap: var(--spacing-12);
		}

		.home-rail {
			position: static;
			display: grid;
			grid-template-columns: 1fr 1fr;
			gap: var(--spacing-8);
		}

		.rail-about {
			grid-column: 1 / -1;
		}
	}

	@media (max-width: 900px) {
		.home-content {
			padding: var(--spacing-6) var(--spacing-4) var(--spacing-12);
		}

		.lead-grid {
			grid-template-columns: 1fr;
			gap: var(--spacing-5);
		}

		.posts-grid {
			grid-template-columns: repeat(2, 1fr);
			gap: var(--spacing-8) var(--spacing-5);
		}
	}

	@media (max-width: 600px) {
		.lead-title {
			font-size: var(--font-size-2xl);
		}

		.posts-grid {
			grid-template-columns: 1fr;
			gap: var(--spacing-8);
		}

		.home-rail {
			grid-template-columns: 1fr;
		}
	}
</style>
