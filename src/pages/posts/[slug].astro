---
/**
 * Legacy template route /posts/{slug} → 301 to /{category}/{slug}.
 * The data redirects registered in EmDash cover the 252 migrated posts;
 * this handles anything newer and acts as a safety net.
 */
import { getEmDashEntry, getEntryTerms, decodeSlug } from "emdash";
import { primaryCategory, postHref } from "../../utils/categories";

const slug = decodeSlug(Astro.params.slug);
if (!slug) return new Response(null, { status: 404 });

const { entry: post } = await getEmDashEntry("posts", slug);
if (!post) return new Response(null, { status: 404 });

const cats = (post.data as any).terms?.category ?? (await getEntryTerms("posts", post.data.id, "category"));
return Astro.redirect(postHref(primaryCategory(cats), slug), 301);
---
