---
import { getMenu, getSiteSettings } from "emdash";
import {
	WidgetArea,
	EmDashHead,
	EmDashBodyStart,
	EmDashBodyEnd,
} from "emdash/ui";
import { createPublicPageContext } from "emdash/page";
import LiveSearch from "emdash/ui/search";
import { Font } from "astro:assets";
import {
	resolveBlogSiteIdentity,
	LOGO_LIGHT_URL,
	LOGO_DARK_URL,
	LOGO_WIDTH,
	LOGO_HEIGHT,
	siteOrigin,
	isCanonicalHost,
	DEFAULT_OG_IMAGE_PATH,
} from "../utils/site-identity";
import { CATEGORIES } from "../utils/categories";
import "../styles/tokens.css";
import "../styles/theme.css";

interface Props {
	title: string;
	pageTitle?: string | null;
	description?: string | null;
	image?: string | null;
	canonical?: string | null;
	robots?: string | null;
	type?: "website" | "article";
	publishedTime?: string | null;
	modifiedTime?: string | null;
	author?: string | null;
	/** Pass content reference for plugin page contributions on content pages */
	content?: { collection: string; id: string; slug?: string | null };
}

const {
	title,
	pageTitle,
	description,
	image,
	canonical,
	robots,
	type = "website",
	publishedTime,
	modifiedTime,
	author,
	content,
} = Astro.props;

const GTM_ID = "GTM-PB56TC7";
const ADSENSE_CLIENT = "ca-pub-5799363994039959";

const { siteTitle, siteTagline } = resolveBlogSiteIdentity(await getSiteSettings());
// If title already includes site title (from getSeoMeta), use as-is
const fullTitle = title.includes(siteTitle) ? title : `${title} | ${siteTitle}`;

// Primary menu from admin; falls back to the category list when unset.
// Primary nav = the four categories + 記事一覧. Items from the admin "primary"
// menu are appended after them (the template seed's Home/About/Posts are ignored).
const menu = await getMenu("primary");
const SEED_MENU_URLS = new Set(["/", "/posts", "/pages/about", "/about"]);
const extraItems = (menu?.items ?? [])
	.filter((i) => !SEED_MENU_URLS.has(i.url) && !CATEGORIES.some((c) => i.url === `/${c.slug}`))
	.map((i) => ({ label: i.label, en: undefined as string | undefined, url: i.url, target: i.target }));
const navItems = [
	...CATEGORIES.map((c) => ({
		label: c.label,
		en: c.en as string | undefined,
		url: `/${c.slug}/`,
		target: undefined as string | undefined,
	})),
	{ label: "記事一覧", en: "All", url: "/articles/", target: undefined as string | undefined },
	...extraItems,
];

const socialMenu = await getMenu("social");

const origin = siteOrigin(Astro.url);
const canonicalUrl = canonical ?? `${origin}${Astro.url.pathname}`;

// Staging / preview hosts are never indexable; the real domain follows the
// per-page robots directive. The header covers non-HTML consumers too.
const onCanonicalHost = isCanonicalHost(Astro.url);
const effectiveRobots = onCanonicalHost ? robots : "noindex, nofollow";
if (!onCanonicalHost) Astro.response.headers.set("X-Robots-Tag", "noindex, nofollow");

// Every page has a share image: the page's own or the site default.
const ogImage = image ?? `${origin}${DEFAULT_OG_IMAGE_PATH}`;

// Edge cache (Cloudflare Workers Cache): anonymous HTML is identical for all
// visitors, so let it be served without invoking the Worker. EmDash purges by
// tag on publish; the short max-age + long SWR covers everything else.
// Editor / preview renders are opted out by EmDash's middleware.
if (Astro.cache?.enabled && !Astro.locals.user && !Astro.url.searchParams.has("_edit")) {
	Astro.cache.set({ maxAge: 600, swr: 86400 });
}

// Build public page context for plugin contributions
// SEO data is passed here and rendered securely by EmDashHead
const pageCtx = createPublicPageContext({
	Astro,
	kind: content ? "content" : "custom",
	pageType: type,
	title: fullTitle,
	pageTitle: pageTitle ?? title,
	description,
	canonical: canonicalUrl,
	image: ogImage,
	content,
	seo: { ogImage, robots: effectiveRobots },
	articleMeta: { publishedTime, modifiedTime, author },
	siteName: siteTitle,
});

const isLoggedIn = !!Astro.locals.user;
const year = new Date().getFullYear();
const currentPath = Astro.url.pathname;
---

<!doctype html>
<html lang="ja">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<Font cssVariable="--font-mono" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			rel="stylesheet"
			href="https://fonts.googleapis.com/css2?family=Noto+Sans+JP:wght@400;500;700;900&family=Barlow+Condensed:wght@600;700;800&display=swap"
		/>
		<title>{fullTitle}</title>
		<meta property="og:locale" content="ja_JP" />
		<link rel="alternate" type="application/rss+xml" title={`${siteTitle} RSS`} href="/rss.xml" />
		<EmDashHead page={pageCtx} />
		<slot name="head" />
		<script is:inline>
			// Apply an explicit theme choice immediately to prevent flash.
			// With no cookie, color-scheme: light dark follows the OS.
			(function () {
				var c = document.cookie;
				var i = c.indexOf("theme=");
				var theme = i >= 0 ? c.slice(i + 6).split(";")[0] : null;
				if (theme === "dark" || theme === "light") {
					document.documentElement.classList.add(theme);
				}
			})();
		</script>
		<!-- Google Tag Manager -->
		<script is:inline define:vars={{ GTM_ID }}>
			(function (w, d, s, l, i) {
				w[l] = w[l] || [];
				w[l].push({ "gtm.start": new Date().getTime(), event: "gtm.js" });
				var f = d.getElementsByTagName(s)[0],
					j = d.createElement(s),
					dl = l != "dataLayer" ? "&l=" + l : "";
				j.async = true;
				j.src = "https://www.googletagmanager.com/gtm.js?id=" + i + dl;
				f.parentNode.insertBefore(j, f);
			})(window, document, "script", "dataLayer", GTM_ID);
		</script>
		<!-- End Google Tag Manager -->
		<script
			is:inline
			async
			src={`https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=${ADSENSE_CLIENT}`}
			crossorigin="anonymous"></script>
	</head>
	<body>
		<!-- Google Tag Manager (noscript) -->
		<noscript
			><iframe
				src={`https://www.googletagmanager.com/ns.html?id=${GTM_ID}`}
				height="0"
				width="0"
				style="display:none;visibility:hidden"></iframe></noscript
		>
		<!-- End Google Tag Manager (noscript) -->
		<EmDashBodyStart page={pageCtx} />
		<a href="#main" class="skip-link">本文へ移動</a>
		<header class="site-header">
			<div class="masthead">
				<a href="/" class="site-title" aria-label={`${siteTitle} ホーム`}>
					<img
						src={LOGO_LIGHT_URL}
						alt={siteTitle}
						width={LOGO_WIDTH}
						height={LOGO_HEIGHT}
						class="site-logo-img site-logo-img--light"
						fetchpriority="high"
					/>
					<img
						src={LOGO_DARK_URL}
						alt=""
						aria-hidden="true"
						width={LOGO_WIDTH}
						height={LOGO_HEIGHT}
						class="site-logo-img site-logo-img--dark"
					/>
				</a>
				<p class="masthead-tagline">{siteTagline}</p>
				<div class="nav-right">
					<LiveSearch
						placeholder="サイト内検索"
						class="site-search"
						inputClass="site-search-input"
						resultsClass="site-search-results"
						resultClass="site-search-result"
						collections={["posts", "pages"]}
					/>
					<button
						type="button"
						class="theme-toggle"
						id="theme-toggle"
						aria-label="テーマを切り替え"
						title="ライト / ダーク"
					>
						<svg class="icon-sun" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="5"></circle><line x1="12" y1="1" x2="12" y2="3"></line><line x1="12" y1="21" x2="12" y2="23"></line><line x1="4.22" y1="4.22" x2="5.64" y2="5.64"></line><line x1="18.36" y1="18.36" x2="19.78" y2="19.78"></line><line x1="1" y1="12" x2="3" y2="12"></line><line x1="21" y1="12" x2="23" y2="12"></line><line x1="4.22" y1="19.78" x2="5.64" y2="18.36"></line><line x1="18.36" y1="5.64" x2="19.78" y2="4.22"></line></svg>
						<svg class="icon-moon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path></svg>
					</button>
					{
						isLoggedIn && (
							<a href="/_emdash/admin" class="nav-admin">
								管理
							</a>
						)
					}
				</div>
			</div>
			<nav class="nav" aria-label="メインナビゲーション">
				<div class="nav-links">
					{
						navItems.map((item, i) => (
							<a
								href={item.url}
								target={item.target}
								aria-current={currentPath === item.url || currentPath.startsWith(item.url) ? "page" : undefined}
							>
								<span class="nav-index" aria-hidden="true">{String(i + 1).padStart(2, "0")}</span>
								{item.en && <span class="nav-en" aria-hidden="true">{item.en}</span>}
								<span class="nav-ja">{item.label}</span>
							</a>
						))
					}
				</div>
			</nav>
		</header>

		<main id="main">
			<slot />
		</main>

		<footer class="site-footer">
			<div class="footer-inner">
				<p class="outline-word footer-word" aria-hidden="true">Eijuchi</p>
				<div class="footer-grid">
					<div class="footer-brand">
						<a href="/" class="footer-logo" aria-label={siteTitle}>
							<img src={LOGO_LIGHT_URL} alt={siteTitle} width={LOGO_WIDTH} height={LOGO_HEIGHT} class="footer-logo-img site-logo-img--light" loading="lazy" />
							<img src={LOGO_DARK_URL} alt="" aria-hidden="true" width={LOGO_WIDTH} height={LOGO_HEIGHT} class="footer-logo-img site-logo-img--dark" loading="lazy" />
						</a>
						<p class="footer-tagline">{siteTagline}</p>
					</div>
					<div class="footer-nav">
						<h2 class="footer-heading">カテゴリ</h2>
						<ul class="footer-links">
							{CATEGORIES.map((c) => (
								<li><a href={`/${c.slug}/`}>{c.label}</a></li>
							))}
							<li><a href="/articles/">記事一覧</a></li>
							<li><a href="/tags/">タグ一覧</a></li>
						</ul>
					</div>
					<div class="footer-nav">
						<h2 class="footer-heading">サイト情報</h2>
						<ul class="footer-links">
							<li><a href="/privacy/">プライバシーポリシー</a></li>
							<li><a href="/contact/">お問い合わせ</a></li>
							<li><a href="/rss.xml">RSS</a></li>
							{
								socialMenu?.items.map((item) => (
									<li>
										<a
											href={item.url}
											target={item.target}
											rel={item.target === "_blank" ? "noopener noreferrer" : undefined}
										>
											{item.label}
										</a>
									</li>
								))
							}
						</ul>
					</div>
					<div class="footer-widgets-section">
						<WidgetArea name="footer" />
					</div>
				</div>
				<div class="footer-bottom">
					<p class="footer-copyright">© {year} {siteTitle} — eijuchi.com</p>
					<p class="footer-note">Powered by <a href="https://emdashcms.com" rel="noopener">EmDash</a> / Built on Cloudflare</p>
				</div>
			</div>
		</footer>

		<script>
			// Theme toggle: light <-> dark, stored in a cookie so SSR can read it later.
			const root = document.documentElement;
			const btn = document.getElementById("theme-toggle");

			function setCookie(name: string, value: string, maxAge: number = 31536000) {
				const secure = location.protocol === "https:" ? "; Secure" : "";
				document.cookie = `${name}=${value}; path=/; max-age=${maxAge}; SameSite=Lax${secure}`;
			}

			function currentTheme(): "light" | "dark" {
				if (root.classList.contains("dark")) return "dark";
				if (root.classList.contains("light")) return "light";
				return window.matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light";
			}

			btn?.addEventListener("click", () => {
				const next = currentTheme() === "dark" ? "light" : "dark";
				root.classList.remove("light", "dark");
				root.classList.add(next);
				setCookie("theme", next);
			});

			// Keep aria state in sync
			const sync = () => btn?.setAttribute("aria-pressed", currentTheme() === "dark" ? "true" : "false");
			sync();
			new MutationObserver(sync).observe(root, { attributes: true, attributeFilter: ["class"] });
		</script>

		<style is:global>
			@layer base;

			@layer base {
				*:where(:not([class*="emdash"]):not([class*="ec-"])),
				*:where(:not([class*="emdash"]):not([class*="ec-"]))::before,
				*:where(:not([class*="emdash"]):not([class*="ec-"]))::after {
					box-sizing: border-box;
				}

				body,
				h1,
				h2,
				h3,
				h4,
				h5,
				h6,
				p,
				ul,
				ol,
				figure,
				blockquote,
				dl,
				dd {
					margin: 0;
				}

				ul,
				ol {
					padding: 0;
				}

				html {
					scroll-behavior: smooth;
				}

				body {
					font-family: var(--font-body);
					font-size: var(--font-size-base);
					line-height: var(--leading-relaxed);
					color: var(--color-text);
					background: var(--color-bg);
					-webkit-font-smoothing: antialiased;
					-moz-osx-font-smoothing: grayscale;
					min-height: 100vh;
				}

				a:where(:not([class*="emdash"]):not([class*="ec-"])) {
					color: var(--color-text);
					text-decoration: underline;
					text-decoration-thickness: 1px;
					text-underline-offset: 3px;
					text-decoration-color: var(--color-border);
					transition: color var(--transition-fast), text-decoration-color var(--transition-fast);
				}

				a:where(:not([class*="emdash"]):not([class*="ec-"])):hover {
					color: var(--color-brand);
					text-decoration-color: var(--color-brand);
				}

				img {
					max-width: 100%;
					height: auto;
					display: block;
				}

				h1,
				h2,
				h3,
				h4,
				h5,
				h6 {
					font-family: var(--font-heading);
					line-height: var(--leading-tight);
					font-weight: var(--font-weight-heading);
					letter-spacing: var(--tracking-snug);
				}

				h1 {
					font-weight: var(--font-weight-display);
					letter-spacing: var(--tracking-tight);
				}

				::selection {
					background: var(--color-ink-fill);
					color: var(--color-on-ink);
				}

			}
		</style>

		<style>
			.skip-link {
				position: absolute;
				left: -999px;
				top: 8px;
				z-index: 1000;
				padding: var(--spacing-2) var(--spacing-3);
				background: var(--color-ink-fill);
				color: var(--color-on-ink);
				border-radius: var(--radius);
			}

			.skip-link:focus {
				left: 8px;
			}

			/* ---- Masthead ------------------------------------------------ */
			.site-header {
				background: var(--color-bg);
				border-bottom: 3px double var(--color-rule-strong);
			}

			.masthead {
				display: flex;
				align-items: center;
				gap: var(--spacing-6);
				max-width: var(--wide-width);
				margin: 0 auto;
				padding: var(--spacing-5) var(--spacing-6) var(--spacing-4);
			}

			.site-title {
				display: block;
				flex: 0 0 auto;
				line-height: 0;
			}

			.site-logo-img {
				height: 52px;
				width: auto;
				display: block;
			}

			.masthead-tagline {
				font-family: var(--font-mono);
				font-size: 0.72rem;
				letter-spacing: 0.04em;
				color: var(--color-muted);
				padding-left: var(--spacing-6);
				border-left: 1px solid var(--color-border);
				line-height: 1.5;
				max-width: 26em;
			}

			/* Logo variant switching (OS preference + explicit toggle). Unlayered so it
			   beats the scoped display rules above. */
			.site-logo-img--dark,
			:global(.footer-logo-img.site-logo-img--dark) {
				display: none;
			}
			:global(:root.dark) .site-logo-img--light,
			:global(:root.dark .footer-logo-img.site-logo-img--light) {
				display: none;
			}
			:global(:root.dark) .site-logo-img--dark,
			:global(:root.dark .footer-logo-img.site-logo-img--dark) {
				display: block;
			}
			@media (prefers-color-scheme: dark) {
				:global(:root:not(.light)) .site-logo-img--light,
				:global(:root:not(.light) .footer-logo-img.site-logo-img--light) {
					display: none;
				}
				:global(:root:not(.light)) .site-logo-img--dark,
				:global(:root:not(.light) .footer-logo-img.site-logo-img--dark) {
					display: block;
				}
			}

			/* Theme toggle icon switching */
			.theme-toggle .icon-moon {
				display: none;
			}
			:global(:root.dark) .theme-toggle .icon-sun {
				display: none;
			}
			:global(:root.dark) .theme-toggle .icon-moon {
				display: block;
			}
			@media (prefers-color-scheme: dark) {
				:global(:root:not(.light)) .theme-toggle .icon-sun {
					display: none;
				}
				:global(:root:not(.light)) .theme-toggle .icon-moon {
					display: block;
				}
			}

			.nav-right {
				display: flex;
				align-items: center;
				gap: var(--spacing-3);
				margin-inline-start: auto;
			}

			.theme-toggle {
				display: inline-flex;
				align-items: center;
				justify-content: center;
				width: 36px;
				height: 36px;
				border-radius: var(--radius);
				border: 1px solid var(--color-border);
				background: transparent;
				color: var(--color-text);
				cursor: pointer;
				transition:
					background var(--transition-fast),
					color var(--transition-fast);
			}

			.theme-toggle:hover {
				background: var(--color-ink-fill);
				color: var(--color-on-ink);
				border-color: var(--color-ink-fill);
			}

			.nav-admin {
				font-family: var(--font-mono);
				font-size: 0.72rem;
				color: var(--color-text-secondary);
				text-decoration: none;
			}

			.nav-admin:hover {
				color: var(--color-brand);
			}

			/* ---- Section nav row ------------------------------------------ */
			.nav {
				max-width: var(--wide-width);
				margin: 0 auto;
				padding: 0 var(--spacing-6);
				border-top: 1px solid var(--color-border);
			}

			.nav-links {
				display: flex;
				align-items: stretch;
				gap: 0;
				font-size: var(--font-size-sm);
				font-weight: 500;
			}

			.nav-links a {
				display: inline-flex;
				align-items: baseline;
				gap: 0.4em;
				padding: 0.55rem 0.9rem 0.5rem;
				margin: 0;
				color: var(--color-text);
				text-decoration: none;
				white-space: nowrap;
				border-right: 1px solid var(--color-border-subtle);
				transition:
					background var(--transition-fast),
					color var(--transition-fast);
			}

			.nav-links a:first-child {
				padding-left: 0;
			}

			.nav-links a:last-child {
				border-right: none;
			}

			.nav-index {
				font-family: var(--font-mono);
				font-size: 0.62rem;
				color: var(--color-muted);
				letter-spacing: 0.04em;
			}

			.nav-en {
				font-family: var(--font-display);
				font-weight: 700;
				font-size: 1.15rem;
				line-height: 1;
				text-transform: uppercase;
				letter-spacing: 0.02em;
			}

			.nav-ja {
				font-size: 0.78rem;
				font-weight: 500;
				color: var(--color-text-secondary);
			}

			.nav-links a:hover .nav-en,
			.nav-links a:hover .nav-ja {
				color: var(--color-brand);
			}

			.nav-links a[aria-current="page"] {
				background: var(--color-ink-fill);
				color: var(--color-on-ink);
				padding-left: 0.9rem;
				border-right-color: transparent;
			}

			.nav-links a[aria-current="page"] .nav-index {
				color: var(--color-brand);
			}

			.nav-links a[aria-current="page"] .nav-ja,
			.nav-links a[aria-current="page"]:hover .nav-en,
			.nav-links a[aria-current="page"]:hover .nav-ja {
				color: var(--color-on-ink);
			}

			/* ---- Search ---------------------------------------------------- */
			.site-search {
				position: relative;
				width: var(--search-input-width);
				--emdash-search-border-focus: var(--color-rule-strong);
			}

			:global(.site-search-input) {
				width: var(--search-input-width);
				padding: 0.45rem 0.6rem;
				font-family: var(--font-body);
				font-size: var(--font-size-sm);
				border: 1px solid var(--color-border);
				border-radius: var(--radius);
				background: transparent;
				color: var(--color-text);
				transition: border-color var(--transition-fast);
			}

			:global(.site-search-input)::placeholder {
				color: var(--color-muted);
			}

			:global(.site-search-input):focus,
			:global(.site-search-input):focus-visible {
				outline: none;
				border-color: var(--color-rule-strong) !important;
				box-shadow: none;
			}

			:global(.site-search-results) {
				position: absolute;
				top: 100%;
				right: 0;
				width: min(420px, 90vw);
				margin-top: var(--spacing-2);
				background: var(--color-bg);
				border: 1px solid var(--color-rule-strong);
				border-radius: var(--radius);
				max-height: 420px;
				overflow-y: auto;
				z-index: 1000;
			}

			:global(.site-search-results .emdash-live-search-loading),
			:global(.site-search-results .emdash-live-search-no-results) {
				padding: var(--spacing-4);
				text-align: center;
				color: var(--color-muted);
				font-size: var(--font-size-sm);
			}

			:global(.site-search-result) {
				display: block;
				padding: var(--spacing-3) var(--spacing-4);
				text-decoration: none;
				color: var(--color-text);
				border-bottom: 1px solid var(--color-border-subtle);
				transition: background var(--transition-fast);
			}

			:global(.site-search-result):last-child {
				border-bottom: none;
			}

			:global(.site-search-result):hover,
			:global(.site-search-result):focus,
			:global(.site-search-result.focused) {
				background: var(--color-bg-subtle);
				outline: none;
			}

			:global(.site-search-result .emdash-live-search-result-title) {
				display: block;
				font-weight: 700;
				font-size: var(--font-size-sm);
			}

			:global(.site-search-result .emdash-live-search-result-collection) {
				display: block;
				font-family: var(--font-mono);
				font-size: 0.68rem;
				color: var(--color-muted);
				text-transform: uppercase;
				letter-spacing: var(--tracking-wide);
				margin-top: 2px;
			}

			:global(.site-search-result .emdash-live-search-result-snippet) {
				display: block;
				font-size: var(--font-size-sm);
				color: var(--color-muted);
				margin-top: var(--spacing-1);
				line-height: var(--leading-snug);
			}

			:global(.site-search-result .emdash-live-search-result-snippet mark) {
				font-weight: 700;
				color: var(--color-text);
				background: transparent;
				text-decoration: underline;
				text-decoration-color: var(--color-brand);
			}

			main {
				min-height: calc(100vh - 300px);
			}

			/* ---- Footer ---------------------------------------------------- */
			.site-footer {
				border-top: 1px solid var(--color-rule-strong);
				margin-top: var(--spacing-16);
				overflow: hidden;
			}

			.footer-inner {
				max-width: var(--wide-width);
				margin: 0 auto;
				padding: var(--spacing-8) var(--spacing-6) var(--spacing-8);
			}

			.footer-word {
				font-size: clamp(4rem, 15vw, 11rem);
				margin: 0 0 var(--spacing-6) -0.04em;
			}

			.footer-grid {
				display: grid;
				grid-template-columns: 2fr 1fr 1fr 1fr;
				gap: var(--spacing-12);
				margin-bottom: var(--spacing-12);
			}

			.footer-brand {
				max-width: 320px;
			}

			.footer-logo {
				display: inline-block;
				line-height: 0;
			}

			.footer-logo-img {
				height: 32px;
				width: auto;
			}

			.footer-tagline {
				margin-top: var(--spacing-4);
				font-size: var(--font-size-sm);
				color: var(--color-text-secondary);
				line-height: 1.8;
			}

			.footer-nav {
				min-width: 0;
			}

			.footer-heading,
			.footer-widgets-section :global(.widget__title) {
				font-family: var(--font-mono);
				font-size: 0.7rem;
				font-weight: 500;
				letter-spacing: var(--tracking-wider);
				text-transform: uppercase;
				color: var(--color-muted);
				margin-bottom: var(--spacing-4);
				padding-bottom: var(--spacing-2);
				border-bottom: 1px solid var(--color-border-subtle);
			}

			.footer-links {
				list-style: none;
			}

			.footer-links li {
				margin-bottom: var(--spacing-2);
			}

			.footer-links a {
				color: var(--color-text);
				text-decoration: none;
				font-size: var(--font-size-sm);
			}

			.footer-links a:hover {
				text-decoration: underline;
				text-underline-offset: 3px;
				text-decoration-color: var(--color-brand);
			}

			.footer-widgets-section :global(.widget-area) {
				display: block;
			}

			.footer-widgets-section :global(.widget__content) {
				color: var(--color-text-secondary);
				font-size: var(--font-size-sm);
				line-height: var(--leading-relaxed);
			}

			.footer-bottom {
				display: flex;
				justify-content: space-between;
				align-items: center;
				gap: var(--spacing-4);
				padding-top: var(--spacing-5);
				border-top: 1px solid var(--color-border);
				font-family: var(--font-mono);
				font-size: 0.7rem;
				letter-spacing: 0.04em;
				color: var(--color-muted);
			}

			.footer-note a {
				color: var(--color-text-secondary);
			}

			@media (max-width: 1000px) {
				.site-search {
					--search-input-width: 150px;
				}

				.masthead-tagline {
					display: none;
				}
			}

			@media (max-width: 900px) {
				.footer-grid {
					grid-template-columns: 1fr 1fr;
					gap: var(--spacing-8);
				}

				.footer-brand {
					grid-column: span 2;
					max-width: none;
				}
			}

			@media (max-width: 760px) {
				.masthead {
					padding: var(--spacing-4) var(--spacing-4) var(--spacing-3);
				}

				.site-logo-img {
					height: 36px;
				}

				.site-search {
					display: none;
				}

				.nav {
					padding: 0 var(--spacing-4);
				}

				.nav-links {
					overflow-x: auto;
					scrollbar-width: none;
					-webkit-overflow-scrolling: touch;
				}

				.nav-links a {
					padding: 0.5rem 0.7rem 0.45rem;
				}

				.nav-en {
					font-size: 1rem;
				}

				.nav-links a[aria-current="page"] {
					padding-left: 0.7rem;
				}

				.nav-links::-webkit-scrollbar {
					display: none;
				}

				.footer-grid {
					grid-template-columns: 1fr;
				}

				.footer-brand {
					grid-column: span 1;
				}

				.footer-bottom {
					flex-direction: column;
					text-align: center;
				}
			}
		</style>

		<script>
			// ⌘K / Ctrl+K to focus search
			document.addEventListener("keydown", (e) => {
				if ((e.metaKey || e.ctrlKey) && e.key === "k") {
					e.preventDefault();
					const searchInput = document.querySelector(".site-search-input") as HTMLInputElement | null;
					searchInput?.focus();
				}
			});
		</script>
		<EmDashBodyEnd page={pageCtx} />
	</body>
</html>
